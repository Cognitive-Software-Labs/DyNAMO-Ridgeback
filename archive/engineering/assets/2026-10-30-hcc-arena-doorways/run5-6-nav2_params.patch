+      # the inscribed-circle path NavFn produced. The omni primitives must match
+      # the 0.05 m costmap resolution.
+      plugin: "nav2_smac_planner::SmacPlannerLattice"
+      lattice_filepath: "$(find-pkg-share nav2_smac_planner)/sample_primitives/5cm_resolution/0.5m_turning_radius/omni/output.json"
+      # Frontier goals can sit in occupied cells; a non-zero tolerance returns
+      # the nearest reachable pose instead of throwing GoalOccupied.
+      tolerance: 0.5
       allow_unknown: true
+      max_planning_time: 5.0
+      smooth_path: true
+      # The omni base backs out of a doorway as cheaply as it drives in; a
