 local_costmap:
   local_costmap:
@@ -264,15 +262,22 @@
     enable_stamped_cmd_vel: true
     planner_plugins: ["GridBased"]
     GridBased:
-      plugin: "nav2_navfn_planner::NavfnPlanner"
-      # Frontier centroids often sit flush against walls, inside the inscribed-
-      # lethal band of the 0.75 m inflation. With tolerance below that band's
-      # width NavFn finds no valid endpoint, the goal aborts, and explore_lite
-      # blacklists the frontier — runs quit with half the map unexplored.
