[Unit]
Description=MMP Ridgeback 2D Lidar Scan Merger (front+rear Hokuyo -> sensors/scan)
After=network-online.target clearpath-sensors.service
Wants=clearpath-sensors.service

[Service]
Type=simple
User=robot
Group=robot
Environment=HOME=/home/robot
Environment=MMP_NS=r100_0160
Environment=ROS_DOMAIN_ID=0
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /opt/mybotshop/install/setup.bash && exec ros2 launch ros2_laser_scan_merger merge_ridgeback.launch.py'
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
