# Stable PS4 controller joystick path for Clearpath teleop_joy.yaml.
KERNEL=="js*", SUBSYSTEM=="input", ATTRS{name}=="DS4DRV Managed Wireless Controller", MODE="0666", SYMLINK+="input/ps4"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", MODE="0666"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", MODE="0666"
