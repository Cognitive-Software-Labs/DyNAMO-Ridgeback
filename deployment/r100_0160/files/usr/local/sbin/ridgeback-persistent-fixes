#!/usr/bin/env bash
set -e

patch_file() {
  local f="$1"
  [ -f "$f" ] || return 0
  shift
  "$@"
}

# WebRTC capacity for camera streams.
for f in \
  /opt/mybotshop/install/robot_webserver/share/robot_webserver/config/robot_webrtc.yaml \
  /opt/mybotshop/src/mybotshop/robot_webserver/config/robot_webrtc.yaml \
  /opt/mybotshop/handover_ws/install/robot_webserver/share/robot_webserver/config/robot_webrtc.yaml \
  /opt/mybotshop/handover_ws/src/mybotshop/robot_webserver/config/robot_webrtc.yaml; do
  [ -f "$f" ] && sed -i -E 's/max_sessions:[[:space:]]*[0-9]+/max_sessions: 512/' "$f"
done

# Keep stale Cockpit pages from failing if they still submit robot-gps-navi.
for f in \
  /opt/mybotshop/install/robot_webserver/share/robot_webserver/config/robot_webserver.yaml \
  /opt/mybotshop/src/mybotshop/robot_webserver/config/robot_webserver.yaml \
  /opt/mybotshop/handover_ws/install/robot_webserver/share/robot_webserver/config/robot_webserver.yaml \
  /opt/mybotshop/handover_ws/src/mybotshop/robot_webserver/config/robot_webserver.yaml; do
  [ -f "$f" ] || continue
  sed -i -E 's/^([[:space:]]*-[[:space:]]+[^#[:space:]][^#]*[^[:space:]])[[:space:]]+\.\.\.[[:space:]]*$/\1/' "$f"
  if ! grep -q 'robot-gps-navi' "$f"; then
    if grep -q '"robot-map-navi"' "$f"; then
      sed -i '/"robot-map-navi"/a\        "robot-gps-navi",' "$f"
    else
      sed -i '/^[[:space:]]*- robot-map-navi[[:space:]]*$/a\    - robot-gps-navi' "$f"
    fi
  fi
done

# SLAM timing/queue parameters.
for f in \
  /opt/mybotshop/install/mmp_nav2/share/mmp_nav2/param/nav2_slam.yaml \
  /opt/mybotshop/src/mybotshop/mmp_nav2/param/nav2_slam.yaml; do
  [ -f "$f" ] || continue
  sed -i -E \
    -e 's/^([[:space:]]*)throttle_scans:[[:space:]]*[0-9]+/\1throttle_scans: 3/' \
    -e 's/^([[:space:]]*)transform_timeout:[[:space:]]*[0-9.]+/\1transform_timeout: 0.5/' \
    "$f"
  if grep -q 'scan_queue_size:' "$f"; then
    sed -i -E 's/^([[:space:]]*)scan_queue_size:[[:space:]]*[0-9]+/\1scan_queue_size: 20/' "$f"
  else
    sed -i '/scan_topic: sensors\/scan/a\      scan_queue_size: 20' "$f"
  fi
done

# Clearpath config tooling can regenerate these at boot; force PS4 and combined joy command path.
if [ -f /etc/clearpath/platform/config/teleop_joy.yaml ]; then
  sed -i "s#dev: '/dev/input/[a-zA-Z0-9]*'#dev: '/dev/input/ps4'#" /etc/clearpath/platform/config/teleop_joy.yaml
fi
if [ -f /etc/clearpath/platform/config/twist_mux.yaml ]; then
  sed -i "s#topic: 'joy_teleop/cmd_vel'#topic: 'joy_teleop/cmd_vel_combined'#" /etc/clearpath/platform/config/twist_mux.yaml
fi

exit 0
