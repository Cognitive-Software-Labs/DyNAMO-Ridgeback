diff --git a/clearpath_gz/launch/gz_sim.launch.py b/clearpath_gz/launch/gz_sim.launch.py
index 69135ab..38589ce 100644
--- a/clearpath_gz/launch/gz_sim.launch.py
+++ b/clearpath_gz/launch/gz_sim.launch.py
@@ -84,13 +84,24 @@ def generate_launch_description():
     packages_paths = [os.path.join(p, 'share') for p in os.getenv('AMENT_PREFIX_PATH').split(':')]
 
     # Set ignition resource path to include all sourced ros packages
+    # Also include ridgeback_autonomy worlds and models
+    pkg_this_exploration = get_package_share_directory('ridgeback_autonomy')
     gz_sim_resource_path = SetEnvironmentVariable(
         name='GZ_SIM_RESOURCE_PATH',
         value=[
             os.path.join(pkg_clearpath_gz, 'worlds') + ':',
             os.path.join(pkg_clearpath_gz, 'meshes') + ':',
+            os.path.join(pkg_this_exploration, 'worlds') + ':',
+            os.path.join(pkg_this_exploration, 'models') + ':',
             ':' + ':'.join(packages_paths)])
 
+    # Add SpawnG1 plugin path so Gazebo GUI can find it
+    gz_gui_plugin_path = SetEnvironmentVariable(
+        name='GZ_GUI_PLUGIN_PATH',
+        value=os.path.join(
+            get_package_share_directory('ridgeback_autonomy'),
+            '..', '..', 'lib', 'ridgeback_autonomy'))
+
     # Clock bridge
     clock_bridge = Node(
         package='ros_gz_bridge',
@@ -105,6 +116,7 @@ def generate_launch_description():
     # Create launch description and add actions
     ld = LaunchDescription(ARGUMENTS)
     ld.add_action(gz_sim_resource_path)
+    ld.add_action(gz_gui_plugin_path)
     ld.add_action(OpaqueFunction(function=gz_launch))
     ld.add_action(clock_bridge)
     return ld
