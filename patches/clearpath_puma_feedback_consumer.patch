+// Snapshot message and monotonic callback receipt together; no check/get race.
+bool PumaHardwareInterface::take_feedback(
+  clearpath_motor_msgs::msg::PumaMultiFeedback & msg,
+  std::chrono::steady_clock::time_point & receipt, bool & header_valid)
+{
+  std::lock_guard<std::mutex> lock(feedback_mutex_);
+  if (pending_feedback_.empty()) return false;
+  msg = pending_feedback_.front().msg;
+  receipt = pending_feedback_.front().receipt;
+  pending_feedback_.pop_front();
+  const double age = get_clock()->now().seconds() - rclcpp::Time(msg.header.stamp).seconds();
+  header_valid = !invalid_header_pending_ && age >= -.005 && age <= .25;
+  invalid_header_pending_ = false;
+  has_feedback_ = !pending_feedback_.empty();
+  return true;
+}
