+    <!-- Simulation renders one idealized RGBD camera in place of the whole
+         device. It hangs off the selected model's colour frame so the rendered
+         viewpoint is the pose of the ${name}_color_optical_frame its products
+         are labelled with. The optics stay simplified on purpose: one FoV, no
+         stereo baseline, no noise model. Only expanded in simulation, both
+         because there is nothing to render on hardware and because the colour
+         frame only exists alongside the nominal extrinsics. -->
+    <xacro:if value="$(arg is_sim)">
+      <gazebo reference="${name}_color_frame">
+        <sensor name="${name}" type="rgbd_camera">
+          <camera>
+            <horizontal_fov>${render_hfov}</horizontal_fov>
+            <image>
+              <width>${render_width}</width>
+              <height>${render_height}</height>
+            </image>
+            <clip>
+              <near>0.3</near>
+              <far>100</far>
+            </clip>
+            <gz_frame_id>${name}_color_frame</gz_frame_id>
+            <optical_frame_id>${name}_color_optical_frame</optical_frame_id>
+          </camera>
+          <always_on>1</always_on>
+          <update_rate>${update_rate}</update_rate>
+          <visualize>true</visualize>
+          <gz_frame_id>${name}_color_frame</gz_frame_id>
+          <topic>$(arg namespace)/sensors/${name}</topic>
+        </sensor>
+      </gazebo>
+    </xacro:if>

