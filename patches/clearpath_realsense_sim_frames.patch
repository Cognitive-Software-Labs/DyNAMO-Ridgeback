 <?xml version="1.0"?>
 <robot xmlns:xacro="http://ros.org/wiki/xacro">
+  <!-- Supplied by the platform description, which derives it from use_sim_time.
+       Declared here too so this macro also expands standalone. -->
+  <xacro:arg name="is_sim" default="false" />
+  <!-- Optional simulator-only overrides. Zero preserves Clearpath's generated
