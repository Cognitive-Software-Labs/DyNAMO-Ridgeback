+       Ridgeback D455 profile. -->
+  <xacro:arg name="sim_camera_width" default="0" />
+  <xacro:arg name="sim_camera_height" default="0" />
+  <xacro:arg name="sim_camera_horizontal_fov" default="0" />
+
   <xacro:macro name="intel_realsense" params="name parent_link model *origin
                                               update_rate:=30.0 image_height:=480 image_width:=640">
+    <!-- On hardware the RealSense driver publishes the factory-calibrated
+         internal camera extrinsics, so the description must not publish a
+         competing copy. Simulation has no driver, so the selected model's
+         nominal frames are the only source for that part of the chain. -->
+    <xacro:property name="use_nominal_extrinsics" value="$(arg is_sim)" />
+    <xacro:property name="sim_width" value="${int('$(arg sim_camera_width)')}" />
+    <xacro:property name="sim_height" value="${int('$(arg sim_camera_height)')}" />
+    <xacro:property name="sim_hfov" value="${float('$(arg sim_camera_horizontal_fov)')}" />
+    <xacro:property name="render_width"
+                    value="${sim_width if sim_width > 0 else image_width}" />
+    <xacro:property name="render_height"
+                    value="${sim_height if sim_height > 0 else image_height}" />
+    <xacro:property name="render_hfov"
+                    value="${sim_hfov if sim_hfov > 0 else 1.25}" />
+
     <xacro:if value="${model == 'd405'}">
