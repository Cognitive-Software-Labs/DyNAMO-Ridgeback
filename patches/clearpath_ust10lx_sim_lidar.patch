+    class HokuyoUSTDescription(Lidar2dDescription):
+        """Simulate the UST-10LX: 0.25 deg steps, 0.06-10 m, 40 Hz, and a
+        constant Gaussian range noise (stddev in metres)."""
+
+        NOISE_STDDEV = 'noise_stddev'
+
+        def __init__(self, sensor: HokuyoUST) -> None:
+            super().__init__(sensor)
+
+            self.parameters.update(
+                {
+                    self.ANGULAR_RESOLUTION: 0.25,
+                    self.MINIMUM_RANGE: 0.06,
+                    self.MAXIMUM_RANGE: 10.0,
+                    self.UPDATE_RATE: 40,
+                    self.NOISE_STDDEV: 0.036,
+                }
+            )
+
     class Lidar3dDescription(BaseDescription):
         ANGULAR_RESOLUTION_H = 'ang_res_h'
         ANGULAR_RESOLUTION_V = 'ang_res_v'
@@ -333,7 +352,7 @@ class SensorDescription:
