+
+#ifndef _WIN32
+#include <gtest/gtest.h>
+
+#include <cstdlib>
+#include <unistd.h>
+#include <future>
+
+// Exercise the real Stop and PostUpdate implementations, including private
+// synchronization state, without adding a runtime test hook or render engine.
+#include "../../src/systems/sensors/Sensors.cc"
+
+using namespace std::chrono_literals;
+
+namespace gz
+{
+namespace sim
+{
+inline namespace GZ_SIM_VERSION_NAMESPACE
+{
+namespace systems
+{
+class SensorsTest : public ::testing::Test
+{
+  public: static void CheckWaiter(int _schedule, int _repeats)
+  {
+    alarm(15);
+    for (int i = 0; i < _repeats; ++i)
+    {
+      Sensors system;
+      auto &data = *system.dataPtr;
+      EventManager events;
+      EntityComponentManager ecm;
+      UpdateInfo info;
+      info.simTime = 19ms;
+      data.eventManager = &events;
+      data.running = true;
+      data.initialized = true;
+      data.updateAvailable = true;
+      data.updateTime = 7ms;
+      data.updateTimeToApply = 2ms;
+      data.updateTimeApplied = 1ms;
+
+      if (_schedule == 0)
+      {
+        data.Stop();
+        system.PostUpdate(info, ecm);
+      }
+      else
+      {
+        std::unique_lock<std::mutex> entry(data.renderUtilMutex,
+            std::defer_lock);
+        if (_schedule == 2)
+          entry.lock();
+        std::promise<void> entered;
+        auto waiter = std::async(std::launch::async, [&]
+        {
+          entered.set_value();
+          system.PostUpdate(info, ecm);
+        });
+        entered.get_future().wait();
+        if (_schedule == 1 && waiter.wait_for(30ms) !=
+            std::future_status::timeout)
+          std::_Exit(2);
+
+        auto stop = std::async(std::launch::async, [&] { data.Stop(); });
+        if (_schedule == 2)
+          entry.unlock();
+        if (stop.wait_for(500ms) != std::future_status::ready ||
+            waiter.wait_for(500ms) != std::future_status::ready)
+          std::_Exit(3);
+        stop.get();
+        waiter.get();
+      }
+      // UpdateFromECM is immediately followed by this assignment. A shutdown
+      // wakeup must return before either operation, even with a pending update.
+      if (data.updateTime != 7ms || data.running)
+        std::_Exit(4);
+      data.Stop();
+    }
+    std::_Exit(0);
+  }
+
+  public: static void CheckJoin()
+  {
+    alarm(5);
+    Sensors system;
+    auto &data = *system.dataPtr;
+    data.running = true;
+    data.renderThread = std::thread([&]
+    {
+      {
+        std::unique_lock<std::mutex> lock(data.renderMutex);
+        data.renderCv.wait(lock, [&] { return !data.running; });
+      }
+      // Stop must release both locks before joining this thread.
+      std::unique_lock<std::mutex> lock(data.renderUtilMutex);
+    });
+    data.Stop();
+    data.Stop();
+    std::_Exit(data.renderThread.joinable() ? 1 : 0);
+  }
+
+  public: static void CheckConcurrentStop()
+  {
+    alarm(5);
+    Sensors system;
+    auto &data = *system.dataPtr;
+    data.running = true;
+    std::promise<void> renderStopping;
+    std::promise<void> releaseRender;
+    auto released = releaseRender.get_future();
+    data.renderThread = std::thread([&]
+    {
+      {
+        std::unique_lock<std::mutex> lock(data.renderMutex);
+        data.renderCv.wait(lock, [&] { return !data.running; });
+      }
+      renderStopping.set_value();
+      released.wait();
+    });
+    auto first = std::async(std::launch::async, [&] { data.Stop(); });
+    renderStopping.get_future().wait();
+    std::promise<void> secondEntered;
+    auto second = std::async(std::launch::async, [&]
+    {
+      secondEntered.set_value();
+      data.Stop();
+    });
+    secondEntered.get_future().wait();
+    // Keep the render thread alive while both callers attempt Stop. With the
+    // old implementation they can both join the same std::thread (undefined).
+    std::this_thread::sleep_for(30ms);
+    releaseRender.set_value();
+    if (first.wait_for(500ms) != std::future_status::ready ||
+        second.wait_for(500ms) != std::future_status::ready)
+      std::_Exit(5);
+    first.get();
+    second.get();
+    std::_Exit(0);
+  }
+
+  public: static void CheckInstances()
+  {
+    alarm(5);
+    EventManager events;
+    Sensors first;
+    Sensors second;
+    first.dataPtr->eventManager = &events;
+    second.dataPtr->eventManager = &events;
+    // Real dormant rendering threads: no rendering sensors or engine needed.
+    first.dataPtr->Run();
+    second.dataPtr->Run();
+    auto stop = std::async(std::launch::async,
+        [&] { first.dataPtr->Stop(); });
+    second.dataPtr->Stop();
+    stop.get();
+    first.dataPtr->Stop();
+    second.dataPtr->Stop();
+    std::_Exit(0);
+  }
+};
+
+// Each child has a CTest timeout as a final bound; early failure uses _Exit so
+// an unfixed waiter cannot hang a future/thread destructor during red testing.
+TEST_F(SensorsTest, StopBeforePostUpdate)
+{
+  ASSERT_EXIT(CheckWaiter(0, 1), ::testing::ExitedWithCode(0), "");
+}
+
+TEST_F(SensorsTest, StopWakesSleepingPostUpdateWithoutUpdateWork)
+{
+  ASSERT_EXIT(CheckWaiter(1, 1), ::testing::ExitedWithCode(0), "");
+}
+
+TEST_F(SensorsTest, StopAroundPostUpdateWaitEntry)
+{
+  // Scheduling stress, not a deterministic lost-wakeup interleaving.
+  ASSERT_EXIT(CheckWaiter(2, 300), ::testing::ExitedWithCode(0), "");
+}
+
+TEST_F(SensorsTest, StopReleasesLocksBeforeJoinAndCanRepeat)
+{
+  ASSERT_EXIT(CheckJoin(), ::testing::ExitedWithCode(0), "");
+}
+
+TEST_F(SensorsTest, IndependentInstancesCanStopTogether)
+{
+  ASSERT_EXIT(CheckInstances(), ::testing::ExitedWithCode(0), "");
+}
+
+TEST_F(SensorsTest, ConcurrentStopsJoinOnlyOnce)
+{
+  ASSERT_EXIT(CheckConcurrentStop(), ::testing::ExitedWithCode(0), "");
+}
+}
+}
+}
+}
+#endif
