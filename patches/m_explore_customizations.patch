+int Explore::countFailure(const geometry_msgs::msg::Point& goal)
+{
+  // match with the same cell tolerance as goalOnBlacklist so a slightly
+  // drifted centroid of the same frontier accumulates onto one tally
+  constexpr static size_t tolerace = 5;
+  double tol =
+      tolerace * costmap_client_.getCostmap()->getResolution();
+  for (auto& [point, count] : failure_counts_) {
+    if (fabs(goal.x - point.x) < tol && fabs(goal.y - point.y) < tol) {
+      return ++count;
+    }
+  }
+  failure_counts_.emplace_back(goal, 1);
+  return 1;
+}
