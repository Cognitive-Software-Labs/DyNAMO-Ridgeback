index 0000000..a115f06
--- /dev/null
+++ b/ros_gz_sim/test/test_scene_state.launch.py
@@ -0,0 +1,258 @@
+# Copyright 2026 Open Source Robotics Foundation, Inc.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Exercise state reporting through scene additions using independent native poses."""
+
+from collections import deque
+import json
+import math
+import os
+import threading
+import time
+import unittest
+
+from gz.msgs10.pose_v_pb2 import Pose_V
+from gz.transport13 import Node as GzNode
+from launch import LaunchDescription
+from launch.actions import SetEnvironmentVariable
+from launch_ros.actions import Node
+import launch_testing
+import launch_testing.actions
+import launch_testing.asserts
+import rclpy
+from simulation_interfaces import srv as si
+from simulation_interfaces.msg import Result, SimulationState
+
+
+WORLD = 'scene_state_regression'
+SDF = """<sdf version="1.9"><world name="scene_state_regression">
+<gravity>0 0 0</gravity>
+<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
+<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
+<plugin filename="gz-sim-scene-broadcaster-system"
+ name="gz::sim::systems::SceneBroadcaster"/>
+<model name="offset_model"><pose>0 0 3 0 0 0</pose>
+<link name="body"><pose>0.3 -0.2 0.1 0 0 0.2</pose>
+<inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
+<visual name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
+</link></model>
+<model name="moving_model"><pose>0 5 3 0 0 0</pose>
+<link name="body"><pose>0.3 -0.2 0.1 0 0 0</pose>
+<inertial><mass>1</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial>
+<visual name="box"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></visual>
+</link><plugin filename="gz-sim-velocity-control-system"
+ name="gz::sim::systems::VelocityControl"><initial_linear>0.4 0 0</initial_linear></plugin>
+</model></world></sdf>"""
+
+
+def generate_test_description():
+    server = Node(package='ros_gz_sim', executable='gzserver', output='screen',
+                  parameters=[{'world_sdf_string': SDF}])
+    return LaunchDescription([
+        SetEnvironmentVariable('GZ_IP', '127.0.0.1'), server,
+        launch_testing.actions.ReadyToTest(),
+    ]), {'server': server}
+
+
+class TestSceneState(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        rclpy.init()
+        cls.node = rclpy.create_node('scene_state_regression')
+        cls.gz = GzNode()
+        cls.lock = threading.Lock()
+        cls.native = None
+        cls.samples = []
+        cls.moving_history = deque(maxlen=100)
+
+        def poses(msg):
+            for p in msg.pose:
+                if p.name == 'offset_model':
+                    stamp = msg.header.stamp.sec + msg.header.stamp.nsec * 1e-9
+                    with cls.lock:
+                        cls.native = (time.monotonic(), stamp, p)
+                elif p.name == 'moving_model':
+                    stamp = msg.header.stamp.sec + msg.header.stamp.nsec * 1e-9
+                    with cls.lock:
+                        cls.moving_history.append((time.monotonic(), stamp, p.position.x))
+
+        cls.pose_callback = poses
+        assert cls.gz.subscribe(Pose_V, f'/world/{WORLD}/pose/info', poses)
+        cls.clients = {}
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.gz.unsubscribe(f'/world/{WORLD}/pose/info')
+        cls.node.destroy_node()
+        rclpy.shutdown()
+
+    def call(self, service_name, **kwargs):
+        types = {'get_entity_state': si.GetEntityState, 'set_entity_state': si.SetEntityState,
+                 'get_entities_states': si.GetEntitiesStates,
+                 'spawn_entity': si.SpawnEntity, 'delete_entity': si.DeleteEntity,
+                 'reset_simulation': si.ResetSimulation,
+                 'set_simulation_state': si.SetSimulationState,
+                 'get_simulation_state': si.GetSimulationState}
+        name = service_name
+        if name not in self.clients:
+            self.clients[name] = self.node.create_client(types[name], f'/gzserver/{name}')
+        client = self.clients[name]
+        self.assertTrue(client.wait_for_service(timeout_sec=20))
+        request = types[name].Request()
+        for key, value in kwargs.items():
+            setattr(request, key, value)
+        f = client.call_async(request)
+        rclpy.spin_until_future_complete(self.node, f, timeout_sec=12)
+        self.assertTrue(f.done(), f'{name} timed out')
+        result = f.result()
+        self.assertEqual(result.result.result, Result.RESULT_OK, result.result.error_message)
+        return result
+
+    def wait_native(self, expected, after=0.0):
+        deadline = time.monotonic() + 5.0
+        while time.monotonic() < deadline:
+            with self.lock:
+                native = self.native
+            if (native is not None and native[0] > after and
+                    abs(native[2].position.x - expected[0]) < 1e-5 and
+                    abs(native[2].position.y - expected[1]) < 1e-5):
+                return
+            rclpy.spin_once(self.node, timeout_sec=0.01)
+        self.fail('native pose did not reach the expected position')
+
+    def observe(self, duration=1.0, expected=(2.0, 1.0, 0.6)):
+        deadline = time.monotonic() + duration
+        count = 0
+        while time.monotonic() < deadline:
+            state = self.call('get_entity_state', entity='offset_model').state
+            bulk_req = si.GetEntitiesStates.Request()
+            bulk_req.filters.filter = '^offset_model$'
+            bulk = self.call('get_entities_states', filters=bulk_req.filters)
+            self.assertEqual(list(bulk.entities), ['offset_model'])
+            with self.lock:
+                native = self.native
+            self.assertIsNotNone(native)
+            age = time.monotonic() - native[0]
+            self.assertLess(age, 0.5, 'stale independent native pose')
+            if os.environ.get('SCENE_STATE_SAMPLES'):
+                with open(os.environ['SCENE_STATE_SAMPLES'], 'a') as out:
+                    out.write(json.dumps({
+                        'wall': time.monotonic(), 'native_stamp': native[1],
+                        'native_age': age, 'native_x': native[2].position.x,
+                        'singular_x': state.pose.position.x,
+                        'bulk_x': bulk.states[0].pose.position.x}) + '\n')
+            for actual in (state, bulk.states[0]):
+                self.assertAlmostEqual(actual.pose.position.x, native[2].position.x, delta=1e-5)
+                self.assertAlmostEqual(actual.pose.position.y, native[2].position.y, delta=1e-5)
+                self.assertAlmostEqual(
+                    actual.pose.orientation.z, native[2].orientation.z, delta=1e-5)
+                self.assertAlmostEqual(actual.pose.position.x, expected[0], delta=1e-5)
+                self.assertAlmostEqual(actual.pose.position.y, expected[1], delta=1e-5)
+                self.assertAlmostEqual(
+                    actual.pose.orientation.z, math.sin(expected[2] / 2), delta=1e-5)
+            self.samples.append(
+                (native[1], age, state.pose.position.x, bulk.states[0].pose.position.x))
+            count += 1
+        self.assertGreater(count, 1)
+
+    def test_01_scene_additions_preserve_stationary_state(self):
+        request = si.SetEntityState.Request()
+        request.state.pose.position.x = 2.0
+        request.state.pose.position.y = 1.0
+        request.state.pose.position.z = 3.0
+        request.state.pose.orientation.z = math.sin(0.3)
+        request.state.pose.orientation.w = math.cos(0.3)
+        self.call('set_entity_state', entity='offset_model', state=request.state)
+        deadline = time.monotonic() + 5
+        while True:
+            state = self.call('get_entity_state', entity='offset_model').state
+            if abs(state.pose.position.x - 2.0) < 1e-5:
+                break
+            self.assertLess(time.monotonic(), deadline, 'move never reached measured pose')
+        self.observe()
+        for i in range(4):
+            request = si.SpawnEntity.Request()
+            request.name = f'unrelated_{i}'
+            request.resource_string = """<sdf version="1.9"><model name="unrelated">
+                <static>true</static><link name="link"><visual name="v">
+                <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
+                </visual></link></model></sdf>"""
+            request.initial_pose.pose.position.x = 10.0
+            request.initial_pose.pose.orientation.w = 1.0
+            self.call('spawn_entity', name=request.name, resource_string=request.resource_string,
+                      initial_pose=request.initial_pose)
+            self.observe(1.5)
+            self.call('delete_entity', entity=request.name)
+            self.observe()
+        print(f'STATE_REGRESSION {len(self.samples)} native-checked pairs')
+
+    def test_02_supported_resets_playing_and_paused(self):
+        for mode in (SimulationState.STATE_PLAYING, SimulationState.STATE_PAUSED):
+            state = si.SetSimulationState.Request().state
+            state.state = mode
+            self.call('set_simulation_state', state=state)
+            for scope in (si.ResetSimulation.Request.SCOPE_DEFAULT,
+                          si.ResetSimulation.Request.SCOPE_ALL):
+                start = time.monotonic()
+                self.call('reset_simulation', scope=scope)
+                print(f'RESET_CASE mode={mode} scope={scope} wall={time.monotonic() - start}')
+                self.assertLess(time.monotonic() - start, 7.0)
+                # Stats arrive on a separate stream. Both paused states preserve
+                # pause; STOPPED is reported once the reset iteration zero arrives.
+                actual_mode = self.call('get_simulation_state').state.state
+                if mode == SimulationState.STATE_PAUSED:
+                    self.assertIn(actual_mode, (SimulationState.STATE_PAUSED,
+                                                SimulationState.STATE_STOPPED))
+                else:
+                    self.assertEqual(actual_mode, mode)
+                self.wait_native((0.0, 0.0), after=start)
+                self.observe(expected=(0.0, 0.0, 0.0))
+        state.state = SimulationState.STATE_PLAYING
+        self.call('set_simulation_state', state=state)
+
+    def test_03_moving_velocity_survives_additions(self):
+        state = si.SetSimulationState.Request().state
+        state.state = SimulationState.STATE_PLAYING
+        self.call('set_simulation_state', state=state)
+        for i in range(3):
+            request = si.SpawnEntity.Request()
+            request.initial_pose.pose.orientation.w = 1.0
+            name = f'moving_prop_{i}'
+            self.call('spawn_entity', name=name, resource_string="""
+                <sdf version="1.9"><model name="prop"><static>true</static>
+                <link name="body"/></model></sdf>""", initial_pose=request.initial_pose)
+            for _ in range(20):
+                one = self.call('get_entity_state', entity='moving_model').state
+                request = si.GetEntitiesStates.Request()
+                request.filters.filter = '^moving_model$'
+                bulk = self.call('get_entities_states', filters=request.filters)
+                self.assertEqual(list(bulk.entities), ['moving_model'])
+                with self.lock:
+                    history = list(self.moving_history)
+                self.assertGreater(len(history), 2)
+                first, last = history[0], history[-1]
+                self.assertLess(time.monotonic() - last[0], 0.5)
+                native_velocity = (last[2] - first[2]) / (last[1] - first[1])
+                self.assertAlmostEqual(native_velocity, 0.4, delta=1e-4)
+                for state in (one, bulk.states[0]):
+                    self.assertAlmostEqual(state.twist.linear.x, native_velocity, delta=1e-4)
+                    self.assertAlmostEqual(state.twist.linear.y, 0.0, delta=1e-4)
+                    self.assertAlmostEqual(state.pose.position.x, last[2], delta=0.03)
+            self.call('delete_entity', entity=name)
+
+
+@launch_testing.post_shutdown_test()
+class TestShutdown(unittest.TestCase):
+    def test_exit(self, proc_info, server):
+        launch_testing.asserts.assertExitCodes(proc_info, process=server)
