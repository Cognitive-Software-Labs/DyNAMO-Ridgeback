+#include "canonical_link_state.hpp"
+
+#include <limits>
+
+#include <gz/sim/Util.hh>
+#include <gz/sim/components/AngularVelocity.hh>
+#include <gz/sim/components/CanonicalLink.hh>
+#include <gz/sim/components/LinearVelocity.hh>
+#include <gz/sim/components/Pose.hh>
+#include <gz/sim/components/World.hh>
+
+namespace ros_gz_sim
+{
+namespace gz_simulation_interfaces
+{
+namespace components = gz::sim::components;
+
+void CanonicalLinkState::PreUpdate(
+  const gz::sim::UpdateInfo &, gz::sim::EntityComponentManager & ecm)
+{
+  const auto world = ecm.EntityByComponents(components::World());
+  if (world != gz::sim::kNullEntity) {
+    if (ecm.SetComponentData<ResetGeneration>(world, this->reset_generation_)) {
+      ecm.SetChanged(world, ResetGeneration::typeId, gz::sim::ComponentState::OneTimeChange);
+    }
+  }
+  // Physics fills requested velocity fields during Update, before SceneBroadcaster
+  // reads them in PostUpdate. Until then they are unavailable, not invented zeros.
+  const auto nan = std::numeric_limits<double>::quiet_NaN();
+  const gz::math::Vector3d unavailable(nan, nan, nan);
+  // A genuine SCOPE_ALL reset restores initial poses and zero velocities in
+  // Physics::Reset, even while paused. A paused stationary link need not receive
+  // another physics pose update, so keep that valid reset state available.
+  const auto initial_velocity = this->reset_pending_ ? gz::math::Vector3d::Zero : unavailable;
+  ecm.Each<components::CanonicalLink>(
+    [&](const gz::sim::Entity & link, const components::CanonicalLink *) {
+      if (this->reset_pending_ || !ecm.Component<components::WorldPose>(link)) {
+        this->initialized_links_.insert(link);
+        ecm.CreateComponent(link, components::WorldPose(gz::sim::worldPose(link, ecm)));
+      }
+      if (this->reset_pending_ || !ecm.Component<components::WorldLinearVelocity>(link)) {
+        this->initialized_links_.insert(link);
+        ecm.CreateComponent(link, components::WorldLinearVelocity(initial_velocity));
+      }
+      if (this->reset_pending_ || !ecm.Component<components::WorldAngularVelocity>(link)) {
+        this->initialized_links_.insert(link);
+        ecm.CreateComponent(link, components::WorldAngularVelocity(initial_velocity));
+      }
+      if (this->reset_pending_ || !ecm.Component<CanonicalLinkStateReady>(link)) {
+        ecm.CreateComponent(link, CanonicalLinkStateReady(false));
+      }
+      return true;
+    });
+  this->reset_pending_ = false;
+}
+
+void CanonicalLinkState::Update(
+  const gz::sim::UpdateInfo &, gz::sim::EntityComponentManager & ecm)
+{
+  // Registered after Physics: publish availability only after physics has filled
+  // the requested fields, before the broadcaster's parallel PostUpdate readers.
+  ecm.Each<components::CanonicalLink, components::WorldPose,
+    components::WorldLinearVelocity, components::WorldAngularVelocity>(
+    [&](const gz::sim::Entity & link, const components::CanonicalLink *,
+    const components::WorldPose * pose, const components::WorldLinearVelocity * linear,
+    const components::WorldAngularVelocity * angular) {
+      if (ecm.SetComponentData<CanonicalLinkStateReady>(
+          link, pose->Data().IsFinite() && linear->Data().IsFinite() && angular->Data().IsFinite()))
+      {
+        ecm.SetChanged(link, CanonicalLinkStateReady::typeId,
+            gz::sim::ComponentState::OneTimeChange);
+      }
+      // Physics can mark a freshly requested WorldPose NoChange when its seed
+      // already equals the true pose. Force its first publication: the mirror
+      // can still contain a pre-reset value for the same entity and component.
+      if (this->initialized_links_.count(link)) {
+        for (auto type : {components::WorldPose::typeId, components::WorldLinearVelocity::typeId,
+          components::WorldAngularVelocity::typeId, CanonicalLinkStateReady::typeId})
+        {
+          ecm.SetChanged(link, type, gz::sim::ComponentState::OneTimeChange);
+        }
+      }
+      return true;
+    });
+  this->initialized_links_.clear();
+}
+
+void CanonicalLinkState::Reset(
+  const gz::sim::UpdateInfo &, gz::sim::EntityComponentManager &)
+{
+  // SceneBroadcaster may have already run Reset. Publish this generation in the
+  // next PreUpdate, so its state message includes the initialization as well.
+  ++this->reset_generation_;
+  this->reset_pending_ = true;
+}
+}  // namespace gz_simulation_interfaces
+}  // namespace ros_gz_sim
