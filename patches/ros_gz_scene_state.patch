+#ifndef GZ_SIMULATION_INTERFACES__CANONICAL_LINK_STATE_HPP_
+#define GZ_SIMULATION_INTERFACES__CANONICAL_LINK_STATE_HPP_
+
+#include <cstdint>
+#include <limits>
+#include <unordered_set>
+
+#include <gz/sim/System.hh>
+#include <gz/sim/components/Component.hh>
+#include <gz/sim/components/Factory.hh>
+
+namespace ros_gz_sim
+{
+namespace gz_simulation_interfaces
+{
+// Serialized with the world state, so reset completion cannot be confused with a
+// scene addition or overtake the corresponding reset state on another topic.
+using ResetGeneration = gz::sim::components::Component<uint64_t, class ResetGenerationTag>;
+GZ_SIM_REGISTER_COMPONENT("ros_gz_sim.ResetGeneration", ResetGeneration)
+
+using CanonicalLinkStateReady =
+  gz::sim::components::Component<bool, class CanonicalLinkStateReadyTag>;
+GZ_SIM_REGISTER_COMPONENT("ros_gz_sim.CanonicalLinkStateReady", CanonicalLinkStateReady)
+
+/// Request physics reporting on the simulation thread. Never write the mirrored
+/// ECM back to the server: even a missing cached field may already exist there.
+class CanonicalLinkState : public gz::sim::System,
+  public gz::sim::ISystemPreUpdate, public gz::sim::ISystemUpdate,
+  public gz::sim::ISystemReset, public gz::sim::ISystemConfigurePriority
+{
+public:
+  gz::sim::System::PriorityType ConfigurePriority() override
+  {
+    return std::numeric_limits<gz::sim::System::PriorityType>::max();
+  }
+  void PreUpdate(const gz::sim::UpdateInfo &, gz::sim::EntityComponentManager & ecm) override;
+  void Update(const gz::sim::UpdateInfo &, gz::sim::EntityComponentManager & ecm) override;
+  void Reset(const gz::sim::UpdateInfo &, gz::sim::EntityComponentManager & ecm) override;
+
+private:
+  uint64_t reset_generation_{0};
+  bool reset_pending_{false};
+  std::unordered_set<gz::sim::Entity> initialized_links_;
+};
+}  // namespace gz_simulation_interfaces
+}  // namespace ros_gz_sim
+#endif  // GZ_SIMULATION_INTERFACES__CANONICAL_LINK_STATE_HPP_
