+
+namespace ros_gz_sim
+{
+namespace gz_simulation_interfaces
+{
+namespace components = gz::sim::components;
+
+TEST(GazeboProxyState, InitializationPreservesRealWorldState)
+{
+  int argc = 0;
+  rclcpp::init(argc, nullptr);
+  gz::sim::EntityComponentManager native;
+  auto link = native.CreateEntity();
+  const gz::math::Pose3d pose(2.3, 1.2, 0.7, 0, 0, 0.8);
+  const gz::math::Vector3d linear(0.4, -0.2, 0.1), angular(0, 0, 0.3);
+  native.CreateComponent(link, components::CanonicalLink());
+  native.CreateComponent(link, components::WorldPose(pose));
+  native.CreateComponent(link, components::WorldLinearVelocity(linear));
+  native.CreateComponent(link, components::WorldAngularVelocity(angular));
+  gz::transport::Node transport;
+  std::function<bool(gz::msgs::StringMsg_V &)> worlds = [](auto & reply) {
+      reply.add_data("proxy_regression"); return true;
+    };
+  std::function<bool(gz::msgs::SerializedStepMap &)> state = [&](auto & reply) {
+      native.State(*reply.mutable_state()); return true;
+    };
+  int writes = 0;
+  std::function<bool(const gz::msgs::WorldControlState &, gz::msgs::Boolean &)> control =
+    [&](const auto &, auto & reply) {++writes; reply.set_data(true); return true;};
+  ASSERT_TRUE(transport.Advertise("/gazebo/worlds", worlds));
+  ASSERT_TRUE(transport.Advertise("/world/proxy_regression/state", state));
+  ASSERT_TRUE(transport.Advertise("/world/proxy_regression/control/state", control));
+  {
+    auto node = std::make_shared<rclcpp::Node>("proxy_regression");
+    GazeboProxy proxy("proxy_regression", node);
+    proxy.WithEcm([&](auto & ecm) {
+        EXPECT_EQ(pose, ecm.template ComponentData<components::WorldPose>(link));
+        EXPECT_EQ(linear, ecm.template ComponentData<components::WorldLinearVelocity>(link));
+        EXPECT_EQ(angular, ecm.template ComponentData<components::WorldAngularVelocity>(link));
+      });
+    EXPECT_EQ(0, writes) << "The reporting cache must never write state back to simulation";
+  }
+  rclcpp::shutdown();
+}
+}  // namespace gz_simulation_interfaces
+}  // namespace ros_gz_sim
diff --git a/ros_gz_sim/test/test_scene_state.launch.py b/ros_gz_sim/test/test_scene_state.launch.py
