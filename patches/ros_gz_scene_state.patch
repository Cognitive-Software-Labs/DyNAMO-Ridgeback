+
+namespace ros_gz_sim
+{
+namespace gz_simulation_interfaces
+{
+namespace components = gz::sim::components;
+
+TEST(CanonicalLinkState, PreservesExistingFieldsAcrossRepeatedInitialization)
+{
+  gz::sim::EntityComponentManager ecm;
+  auto world = ecm.CreateEntity();
+  ecm.CreateComponent(world, components::World());
+  auto model = ecm.CreateEntity();
+  ecm.CreateComponent(model, components::Pose({2, 1, 3, 0, 0, 0.6}));
+  ecm.CreateComponent(model, components::ParentEntity(world));
+  auto link = ecm.CreateEntity();
+  ecm.CreateComponent(link, components::CanonicalLink());
+  ecm.CreateComponent(link, components::Pose({0.3, -0.2, 0.1, 0, 0, 0.2}));
+  ecm.CreateComponent(link, components::ParentEntity(model));
+  const auto pose = gz::sim::worldPose(link, ecm);
+  const gz::math::Vector3d velocity(0.4, -0.2, 0.1), angular(0, 0, 0.3);
+  ecm.CreateComponent(link, components::WorldPose(pose));
+  ecm.CreateComponent(link, components::WorldLinearVelocity(velocity));
+  ecm.CreateComponent(link, components::WorldAngularVelocity(angular));
+  CanonicalLinkState system;
+  for (int i = 0; i < 20; ++i) {
+    auto unrelated = ecm.CreateEntity();
+    ecm.CreateComponent(unrelated, components::CanonicalLink());
+    system.PreUpdate({}, ecm);
+    EXPECT_EQ(pose, ecm.ComponentData<components::WorldPose>(link));
+    EXPECT_EQ(velocity, ecm.ComponentData<components::WorldLinearVelocity>(link));
+    EXPECT_EQ(angular, ecm.ComponentData<components::WorldAngularVelocity>(link));
+  }
+}
+
+TEST(CanonicalLinkState, MissingFieldsWaitForPhysicsAndResetIsDistinct)
+{
+  gz::sim::EntityComponentManager ecm;
+  auto world = ecm.CreateEntity();
+  ecm.CreateComponent(world, components::World());
+  auto link = ecm.CreateEntity();
+  ecm.CreateComponent(link, components::CanonicalLink());
+  ecm.CreateComponent(link, components::Pose({2, 1, 3, 0, 0, 0.6}));
+  CanonicalLinkState system;
+  system.PreUpdate({}, ecm);
+  EXPECT_EQ(0u, ecm.ComponentData<ResetGeneration>(world));
+  EXPECT_EQ(gz::sim::worldPose(link, ecm), ecm.ComponentData<components::WorldPose>(link));
+  EXPECT_FALSE(ecm.ComponentData<components::WorldLinearVelocity>(link)->IsFinite());
+  EXPECT_FALSE(ecm.ComponentData<components::WorldAngularVelocity>(link)->IsFinite());
+  ecm.SetAllComponentsUnchanged();
+  ecm.SetComponentData<components::WorldLinearVelocity>(link, gz::math::Vector3d::Zero);
+  ecm.SetComponentData<components::WorldAngularVelocity>(link, gz::math::Vector3d::Zero);
+  ecm.SetChanged(link, components::WorldPose::typeId, gz::sim::ComponentState::NoChange);
+  system.Update({}, ecm);
+  EXPECT_TRUE(ecm.ComponentData<CanonicalLinkStateReady>(link).value());
+  EXPECT_EQ(gz::sim::ComponentState::OneTimeChange,
+    ecm.ComponentState(link, components::WorldPose::typeId));
+  system.Reset({}, ecm);
+  system.PreUpdate({}, ecm);
+  EXPECT_EQ(1u, ecm.ComponentData<ResetGeneration>(world));
+  system.PreUpdate({}, ecm);
+  EXPECT_EQ(1u, ecm.ComponentData<ResetGeneration>(world));
+  system.Reset({}, ecm);
+  system.PreUpdate({}, ecm);
+  EXPECT_EQ(2u, ecm.ComponentData<ResetGeneration>(world));
+}
+}  // namespace gz_simulation_interfaces
+}  // namespace ros_gz_sim
