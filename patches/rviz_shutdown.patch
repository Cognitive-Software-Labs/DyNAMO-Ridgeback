+
+#include <gtest/gtest.h>
+
+#include <QApplication>  // NOLINT: cpplint cannot handle the Qt include order
+#include <QPointer>  // NOLINT: cpplint cannot handle the Qt include order
+
+#include <memory>
+
+#include "rclcpp/rclcpp.hpp"
+#include "rviz_common/render_panel.hpp"
+#include "rviz_common/ros_integration/ros_node_abstraction.hpp"
+#include "rviz_common/view_controller.hpp"
+#include "rviz_common/view_manager.hpp"
+#include "rviz_common/visualization_manager.hpp"
+#include "rviz_rendering/render_window.hpp"
+
+#include "ogre_testing_environment.hpp"
+
+TEST(VisualizationManager, releasesCurrentAndSavedViewsBeforeRosNode)
+{
+  int argc = 1;
+  char name[] = "visualization_manager_lifecycle_test";
+  char * argv[] = {name, nullptr};
+  QApplication application(argc, argv);
+  rclcpp::init(argc, argv);
+  rviz_common::OgreTestingEnvironment rendering;
+  rendering.setUpOgreTestEnvironment();
+
+  auto abstraction =
+    std::make_shared<rviz_common::ros_integration::RosNodeAbstraction>(name);
+  auto node = abstraction->get_raw_node();
+  node->set_parameter(rclcpp::Parameter("use_sim_time", true));
+  std::weak_ptr<rclcpp::node_interfaces::NodeBaseInterface> node_base =
+    node->get_node_base_interface();
+
+  auto panel = std::make_unique<rviz_common::RenderPanel>();
+  // Expose the window before creating view meshes so Ogre has a current GL context.
+  panel->resize(320, 240);
+  panel->show();
+  QApplication::processEvents();
+  panel->getRenderWindow()->initialize();
+  QApplication::processEvents();
+  auto manager = std::make_unique<rviz_common::VisualizationManager>(
+    panel.get(), abstraction, nullptr, node->get_clock());
+  panel->initialize(manager.get());
+  QPointer<rviz_common::ViewManager> views = manager->getViewManager();
+  manager->initialize();
+  QPointer<rviz_common::ViewController> current = views->getCurrent();
+  ASSERT_NE(current, nullptr);
+  views->copyCurrentToList();
+  ASSERT_EQ(views->getNumViews(), 1);
+  QPointer<rviz_common::ViewController> saved = views->getViewAt(0);
+  ASSERT_NE(saved, nullptr);
+  ASSERT_NE(saved, current);
+
+  manager.reset();
+
+  EXPECT_TRUE(views.isNull()) << "VisualizationManager must own its ViewManager";
+  EXPECT_TRUE(current.isNull()) << "Current view must be released before its scene/context";
+  EXPECT_TRUE(saved.isNull()) << "Saved views must be released with their property model";
+  abstraction.reset();
+  node.reset();
+  EXPECT_TRUE(node_base.expired()) << "View reset-time services must release their NodeBase owner";
+
+  panel.reset();
+  rclcpp::shutdown();
+}
diff --git a/rviz_default_plugins/include/rviz_default_plugins/displays/image/image_transport_display.hpp b/rviz_default_plugins/include/rviz_default_plugins/displays/image/image_transport_display.hpp
index d6b8e431..639a2567 100644
--- a/rviz_default_plugins/include/rviz_default_plugins/displays/image/image_transport_display.hpp
+++ b/rviz_default_plugins/include/rviz_default_plugins/displays/image/image_transport_display.hpp
@@ -148,7 +148,14 @@ protected:
 
   virtual void unsubscribe()
   {
-    subscription_callback_.disconnect();
+    // The connection holds the raw address of the subscriber filter's
+    // signal. Disconnect only while that filter is alive, and forget the
+    // connection before the filter goes, so a second unsubscribe -- onDisable
+    // and then the destructor -- cannot reach a destroyed filter.
+    if (subscription_) {
+      subscription_callback_.disconnect();
+    }
+    subscription_callback_ = message_filters::Connection();
     subscription_.reset();
   }
 
