<?xml version="1.0" encoding="UTF-8"?>
<!-- Simulation demonstrations are confined to this host, including discovery. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface name="lo" multicast="false"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
    <Internal><SocketReceiveBufferSize max="16MiB"/></Internal>
  </Domain>
</CycloneDDS>
