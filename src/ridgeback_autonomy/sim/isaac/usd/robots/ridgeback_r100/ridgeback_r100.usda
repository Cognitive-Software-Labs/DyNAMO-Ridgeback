#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "tn__r1000001_bC"
    doc = """Generated from Composed Stage of root layer /tmp/tmp8rmhkezp/r100-0001.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ridgeback_r100_wpqgx0p6/usdex_ridgeback_r100/r100-0001.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_ridgeback_r100_wpqgx0p6/temp_ridgeback_r100/ridgeback_r100.usd


Generated from Composed Stage of root layer /home/deivid/dev/DyNAMO-Ridgeback/.claude/worktrees/jolly-borg-f48cab/src/ridgeback_autonomy/sim/isaac/usd/robots/ridgeback_r100.usd/ridgeback_r100/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tn__r1000001_bC" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    def Scope "drive_rig"
    {
        def Xform "anchor" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
        }

        def Xform "carrier_x" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
        }

        def Xform "carrier_y" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            float physics:mass = 1
        }

        def PhysicsFixedJoint "world_fix" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
            rel physics:body1 = </tn__r1000001_bC/drive_rig/anchor>
            int physxArticulation:solverPositionIterationCount = 32
            int physxArticulation:solverVelocityIterationCount = 16
        }

        def PhysicsPrismaticJoint "px" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 100000
            float drive:linear:physics:stiffness = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </tn__r1000001_bC/drive_rig/anchor>
            rel physics:body1 = </tn__r1000001_bC/drive_rig/carrier_x>
        }

        def PhysicsPrismaticJoint "py" (
            prepend apiSchemas = ["PhysicsDriveAPI:linear"]
        )
        {
            float drive:linear:physics:damping = 100000
            float drive:linear:physics:stiffness = 0
            float drive:linear:physics:targetVelocity = 0
            uniform token drive:linear:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </tn__r1000001_bC/drive_rig/carrier_x>
            rel physics:body1 = </tn__r1000001_bC/drive_rig/carrier_y>
        }

        def PhysicsRevoluteJoint "rz" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 100000
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </tn__r1000001_bC/drive_rig/carrier_y>
            rel physics:body1 = </tn__r1000001_bC/Geometry/base_link/chassis_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "chassis_link"
            {
                def Cube "chassis_collision" (
                    prepend apiSchemas = ["PhysicsCollisionAPI"]
                )
                {
                    uniform token purpose = "guide"
                    double size = 1
                    float3 xformOp:scale = (0.9325076, 0.78999, 0.27173406)
                    double3 xformOp:translate = (0, 0, 0.13965854048728943)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }
        }
    }

    over "Physics"
    {
        over "front_left_wheel_joint"
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
        }

        over "front_right_wheel_joint"
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
        }

        over "rear_left_wheel_joint"
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
        }

        over "rear_right_wheel_joint"
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetVelocity = 0
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_13"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_13.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_13.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_13.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_13.inputs:roughness>
        token outputs:displacement
        token outputs:surface
