<?xml version="1.0"?>
<model>
  <name>cabinet_tall</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Supply locker occluder: 0.6 x 0.6 x 1.9 solid box. Taller than the G1 — full vertical block with depth extent.
    Origin at the model base so spawning at z=0 places it on the floor.
  </description>
</model>
