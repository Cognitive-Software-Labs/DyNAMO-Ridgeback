<?xml version="1.0"?>
<model>
  <name>hospital_bed</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Hospital bed occluder (0.5 m tall box), lifted from mock_hospital.sdf.
    Origin at the model base so spawning at z=0 places it on the floor.
    A low, partial occluder for a standing G1 in benchmark scenes.
  </description>
</model>
