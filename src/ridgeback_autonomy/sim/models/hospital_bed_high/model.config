<?xml version="1.0"?>
<model>
  <name>hospital_bed_high</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Raised hospital bed occluder (0.75 m tall solid box, 2.0 x 1.0). Straddles robot mid-body height; taller sibling of hospital_bed.
    Origin at the model base so spawning at z=0 places it on the floor.
  </description>
</model>
