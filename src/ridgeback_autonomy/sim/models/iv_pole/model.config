<?xml version="1.0"?>
<model>
  <name>iv_pole</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    IV stand occluder: 1.8 m thin rod on a 0.45 m base. Near-zero lidar cross-section; splits robot masks from any viewing angle.
    Origin at the model base so spawning at z=0 places it on the floor.
  </description>
</model>
