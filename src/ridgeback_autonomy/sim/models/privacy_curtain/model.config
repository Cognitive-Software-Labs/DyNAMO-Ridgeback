<?xml version="1.0"?>
<model>
  <name>privacy_curtain</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Privacy-curtain occluder (thin 1.6 m tall panel), lifted from
    mock_hospital.sdf. Origin at the model base so spawning at z=0 places it on
    the floor. A tall, near-full occluder for a standing G1 in benchmark scenes.
  </description>
</model>
