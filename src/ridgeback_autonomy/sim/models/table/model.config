<?xml version="1.0"?>
<model>
  <name>table</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Work/overbed table occluder: 1.2 x 0.7 slab at 0.75 m on four legs. Partially transparent occluder — lidar and camera see between the legs.
    Origin at the model base so spawning at z=0 places it on the floor.
  </description>
</model>
