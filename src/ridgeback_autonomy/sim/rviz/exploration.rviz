Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /SLAM Map1
        - /Target Estimates1
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /SetInitialPose1
      - /SetGoal1
    Name: Tool Properties
    Splitter Ratio: 0.58
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/robot_description
      Enabled: true
      Name: RobotModel
      TF Prefix: ""
      Value: true
    - Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: SLAM Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/map_updates
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Enabled: true
      Name: Lidar Front
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /r100_0001/sensors/lidar2d_0/scan
      Value: true
    - Class: rviz_default_plugins/Polygon
      Alpha: 1
      Color: 255; 25; 0
      Enabled: true
      Name: Collision Zone (approach)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/collision_monitor/footprint_approach
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Color: 0; 0; 255
      Color Transformer: FlatColor
      Enabled: true
      Name: Lidar Rear
      Size (m): 0.05
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /r100_0001/sensors/lidar2d_1/scan
      Value: true
    - Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: false
      Name: Global Costmap
      Topic: /r100_0001/global_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Enabled: false
      Name: Local Costmap
      Topic: /r100_0001/local_costmap/costmap
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Name: Global Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/plan
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Target Estimates
      # One checkbox per marker namespace, and ring and dot share theirs, so
      # unticking a row drops both. Listed rather than discovered so the four
      # are configurable before anything has published -- test_launch_layout
      # asserts these keys against PUBLIC_ESTIMATOR_ORDER, because a renamed
      # estimator would otherwise leave a checkbox for a namespace nothing
      # publishes and the new row would arrive unconfigured.
      Namespaces:
        target_estimates/pointcloud: true
        target_estimates/projective_ranging: true
        target_estimates/euclidean_reconstruction: true
        target_estimates/polar_profiling: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/visualization/target/estimates
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Target Polar Rays
      Namespaces:
        polar/used: true
        polar/wedge: true
        polar/dropped: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/visualization/target/polar_rays
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Perception overlay
      Normalize Range: true
      Queue Size: 10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /r100_0001/debug/target/overlay
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Frontiers
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/explore/frontiers
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: MPPI Optimal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/optimal_trajectory
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MPPI Samples
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/trajectories
      Value: true
    - Class: rviz_2d_overlay_plugins/TextOverlay
      Enabled: true
      Name: HUD
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/hud_overlay
      Value: true
    # A second overlay, from hud_target_node: the distance panel is rich text and
    # the velocity/coverage panels align their columns with runs of spaces,
    # which rich text collapses, so the two cannot share an aggregator. Needs no
    # Window Geometry entry -- a TextOverlay is drawn on the 3D view, not docked.
    - Class: rviz_2d_overlay_plugins/TextOverlay
      Enabled: true
      Name: Target HUD
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /r100_0001/hud_target_overlay
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /r100_0001/initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /r100_0001/goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 50
      Target Frame: map
      Value: TopDownOrtho
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 1400
  Hide Left Dock: false
  Hide Right Dock: false
  Perception overlay:
    collapsed: false
  # Dock placement lives ONLY here (see benchmark.rviz for why). Generated by
  # QMainWindow::saveState() at 2560x1400: left dock 460 wide with
  # Displays/Selection/Tool Properties/Views, and Perception overlay full width
  # across the bottom at 2560x306. Without it, rviz_common's addPane() hardcodes
  # Qt::LeftDockWidgetArea and the overlay lands in the narrow left dock a few
  # tens of pixels tall.
  #
  # The bottom dock's height is the one field here worth editing by hand: it is
  # a plain big-endian int in the dock-area header (the third int after the
  # "Perception overlay" pane name's block, preceded by area index 3 and width
  # 2560), and the central widget's height four ints past the name must move by
  # the same amount in the opposite direction. That is how 266 became 306.
  # Nothing else in this blob is safe to edit by hand.
  #
  # Regenerate it the same way -- drag the pane, then File -> Save Config -- and
  # never by hand or by adapting benchmark.rviz's, whose pane set differs. The
  # objectNames inside are the pane names, i.e. the keys in this same block;
  # restoreState() returns false on any it cannot find and then restores
  # NOTHING, silently, so a near-miss loses the whole layout rather than just
  # the new dock. That is why this needs a screenshot, not a build.
  QMainWindow State: 
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 2560
  X: 0
  Y: 24
