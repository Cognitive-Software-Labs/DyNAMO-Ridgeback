<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mock_hospital">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.72 0.72 0.72 1</ambient>
      <background>0.96 0.97 0.99 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.25 0.15 -1</direction>
    </light>

    <model name="hospital_floor">
      <static>true</static>
      <pose>5 0 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry>
            <box><size>24 18 0.1</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>24 18 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="corridor_strip">
      <static>true</static>
      <pose>5 0 0.051 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry>
            <box><size>20 2.9 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.88 0.90 0.93 1</ambient>
            <diffuse>0.88 0.90 0.93 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

