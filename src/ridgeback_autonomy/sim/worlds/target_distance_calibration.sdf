<?xml version="1.0"?>
<sdf version="1.9">
  <world name="target_distance_calibration">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="libgz-sim-imu-system.so"/>
    <plugin name="gz::sim::systems::NavSat" filename="libgz-sim-navsat-system.so"/>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.78 0.78 0.78 1</ambient>
      <background>0.98 0.99 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.2 0.15 -1</direction>
    </light>

    <model name="calibration_floor">
      <static>true</static>
      <pose>3 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>18 10 0.1</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>18 10 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.93 0.93 0.93 1</ambient>
            <diffuse>0.96 0.96 0.96 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10 2.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 2.8</size></box></geometry>
          <material>
            <ambient>0.99 0.99 1.0 1</ambient>
            <diffuse>0.99 0.99 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>12 0 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10 2.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 2.8</size></box></geometry>
          <material>
            <ambient>0.99 0.99 1.0 1</ambient>
            <diffuse>0.99 0.99 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>3 5 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18 0.2 2.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>18 0.2 2.8</size></box></geometry>
          <material>
            <ambient>0.99 0.99 1.0 1</ambient>
            <diffuse>0.99 0.99 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>3 -5 1.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18 0.2 2.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>18 0.2 2.8</size></box></geometry>
          <material>
            <ambient>0.99 0.99 1.0 1</ambient>
            <diffuse>0.99 0.99 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
