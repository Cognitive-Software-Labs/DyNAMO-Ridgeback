<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ridgeback_autonomy_gz</name>
  <version>0.1.0</version>
  <description>Gazebo adapter, worlds, models, and GUI plugin for Ridgeback autonomy</description>
  <maintainer email="davszi@todo.com">davszi</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>gz-gui-vendor</build_depend>
  <build_depend>gz-plugin-vendor</build_depend>
  <build_depend>gz-common-vendor</build_depend>
  <build_depend>qtbase5-dev</build_depend>
  <build_depend>qtdeclarative5-dev</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>clearpath_config</exec_depend>
  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>ridgeback_common</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ridgeback_autonomy</exec_depend>
  <!-- gzserver serves the standard simulation_interfaces scene-control services. -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>simulation_interfaces</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
