<?xml version="1.0"?>
<!-- Background prop: tall metal cabinet. Fuel mesh, see NOTICE.md. -->
<sdf version="1.9">
  <model name="bg_metal_cabinet">
    <static>true</static>
    <link name="link">
      <visual name="cabinet">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>meshes/MetalCabinet.obj</uri><scale>1 1 1</scale></mesh></geometry>
