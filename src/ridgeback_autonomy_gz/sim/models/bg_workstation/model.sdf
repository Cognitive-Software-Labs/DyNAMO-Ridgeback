<?xml version="1.0"?>
<!-- Background prop: desk with monitor and keyboard. Fuel meshes, see NOTICE.md. -->
<sdf version="1.9">
  <model name="bg_workstation">
    <static>true</static>
    <link name="link">
      <visual name="desk">
        <pose>0 -0.019 0 0 0 -1.5708</pose>
        <geometry><mesh><uri>meshes/desk.obj</uri><scale>1.36 1.36 1.36</scale></mesh></geometry>
      </visual>
      <visual name="monitor">
        <pose>0 0.2 0.7507 0 0 1.5708</pose>
        <geometry><mesh><uri>meshes/monitor.obj</uri><scale>0.15 0.15 0.15</scale></mesh></geometry>
      </visual>
      <visual name="keyboard">
        <pose>0 -0.05 0.7507 0 0 1.5708</pose>
        <geometry><mesh><uri>meshes/keyboard.obj</uri><scale>0.15 0.15 0.15</scale></mesh></geometry>
      </visual>
      <collision name="collision_desk">
        <pose>0 0 0.3754 0 0 0</pose>
        <geometry><box><size>1.148 0.666 0.7507</size></box></geometry>
      </collision>
      <collision name="collision_monitor">
        <pose>0 0.18 0.9707 0 0 0</pose>
        <geometry><box><size>0.59 0.16 0.44</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
