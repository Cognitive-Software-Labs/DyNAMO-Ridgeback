<?xml version="1.0"?>
<model>
  <name>cabinet</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Dresser/med-cart occluder: 0.5 x 0.9 x 1.2 solid box. Tall solid WITH depth extent — depth paths see a range band, not a plane.
    Origin at the model base so spawning at z=0 places it on the floor.
  </description>
</model>
