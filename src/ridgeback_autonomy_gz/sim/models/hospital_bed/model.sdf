<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hospital_bed">
    <static>true</static>
    <!-- Box 1.8 x 0.9 x 0.5 lifted 0.25 so the model origin sits on the floor. -->
    <link name="link">
      <collision name="collision">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><box><size>1.8 0.9 0.5</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><box><size>1.8 0.9 0.5</size></box></geometry>
        <material>
          <ambient>0.78 0.88 0.95 1</ambient>
          <diffuse>0.78 0.88 0.95 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
