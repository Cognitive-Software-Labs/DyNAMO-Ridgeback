<?xml version="1.0" encoding="UTF-8"?>
<!-- Camera-only tuning candidate, rendered by camera_service. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface name="br0"/></Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
      @MAX_MESSAGE_SIZE@
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>250</MaxAutoParticipantIndex>
      <Peers><Peer address="192.168.131.51"/></Peers>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize max="16MB"/>
      <SocketSendBufferSize min="16MB" max="16MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
