<?xml version="1.0" encoding="UTF-8"?>
<!--
  Intel: repository nodes and ros2 CLI sessions that receive from Thor,
  through dds_env.sh. Robot Ethernet only: a reader that also advertised its
  Wi-Fi address would make Thor send to it over Wi-Fi.
  See docs/physical/intel_thor_transport.md.

  The receive buffer is a soft maximum: processes still start if
  net.core.rmem_max has not been raised, and check_link verifies the limit.
  The participant-index ceiling matches src/ridgeback_autonomy/config/cyclonedds.xml.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface address="192.168.131.1"/>
      </Interfaces>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>250</MaxAutoParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize max="16MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
