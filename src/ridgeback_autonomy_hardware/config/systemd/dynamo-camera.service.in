# Template for /etc/systemd/system/dynamo-camera.service, rendered by
# tools/intel_thor/camera_service. Edit it here and re-run `apply`.
#
# The driver owns the D455 from boot and publishes the camera_0 contract the
# simulators publish: it runs in /<ns>/sensors as camera_0, its TF goes to the
# robot's namespaced tree, and its colour and aligned-depth outputs, with each
# image_transport variant, are remapped onto the simulator topic names.
# /etc/clearpath/setup.bash supplies the same middleware, domain and DDS profile
# as the Clearpath services.
[Unit]
Description=DyNAMO D455 on the camera_0 contract
After=clearpath-robot.service network-online.target
Wants=clearpath-robot.service network-online.target
Conflicts=realsense-camera.service

[Service]
Type=simple
User=robot
ExecStart=/bin/bash -c 'source /etc/clearpath/setup.bash && @DDS_OVERRIDE@exec /opt/ros/jazzy/lib/realsense2_camera/realsense2_camera_node --ros-args -r __ns:=/@NAMESPACE@/sensors -r __node:=camera_0 --params-file @PARAMS@ -r /tf:=/@NAMESPACE@/tf -r /tf_static:=/@NAMESPACE@/tf_static @TOPIC_REMAPS@'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
