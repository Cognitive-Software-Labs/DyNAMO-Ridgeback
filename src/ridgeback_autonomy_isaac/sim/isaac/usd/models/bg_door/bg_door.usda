#usda 1.0
(
    defaultPrim = "bg_door"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bg_door"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Scope "Looks"
    {
        def Material "mat_000"
        {
            token outputs:surface.connect = </bg_door/Looks/mat_000/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.52)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "mat_001"
        {
            token outputs:surface.connect = </bg_door/Looks/mat_001/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.6, 0.45)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "mat_002"
        {
            token outputs:surface.connect = </bg_door/Looks/mat_002/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.12, 0.13)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }
    }

    def Cube "jamb_left" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_door/Looks/mat_000>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.06, 0.06, 2.1)
        double3 xformOp:translate = (-0.47, 0, 1.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "jamb_right" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_door/Looks/mat_000>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.06, 0.06, 2.1)
        double3 xformOp:translate = (0.47, 0, 1.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "head" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_door/Looks/mat_000>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.88, 0.06, 0.06)
        double3 xformOp:translate = (0, 0, 2.07)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "leaf" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_door/Looks/mat_001>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.88, 0.04, 2.04)
        double3 xformOp:translate = (0, 0.005, 1.02)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "handle" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_door/Looks/mat_002>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.12, 0.015, 0.02)
        double3 xformOp:translate = (0.33, -0.0225, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "collision_body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token purpose = "guide"
        double size = 1
        token visibility = "invisible"
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 0.06, 2.1)
        double3 xformOp:translate = (0, 0, 1.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
