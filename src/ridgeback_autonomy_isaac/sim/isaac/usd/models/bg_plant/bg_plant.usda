#usda 1.0
(
    defaultPrim = "bg_plant"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bg_plant"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Scope "Looks"
    {
        def Material "mat_000"
        {
            token outputs:surface.connect = </bg_plant/Looks/mat_000/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.32, 0.2)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "mat_001"
        {
            token outputs:surface.connect = </bg_plant/Looks/mat_001/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.14, 0.1)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "mat_002"
        {
            token outputs:surface.connect = </bg_plant/Looks/mat_002/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.42, 0.3)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "mat_003"
        {
            token outputs:surface.connect = </bg_plant/Looks/mat_003/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.42, 0.18)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "mat_004"
        {
            token outputs:surface.connect = </bg_plant/Looks/mat_004/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.16, 0.36, 0.14)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }
    }

    def Cylinder "pot" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.32
        rel material:binding = </bg_plant/Looks/mat_000>
        double radius = 0.16
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.16)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Cylinder "soil" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.02
        rel material:binding = </bg_plant/Looks/mat_001>
        double radius = 0.15
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.33)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Cylinder "stem" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.5
        rel material:binding = </bg_plant/Looks/mat_002>
        double radius = 0.02
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.59)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Sphere "foliage_0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_plant/Looks/mat_003>
        double radius = 0.22
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Sphere "foliage_1" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_plant/Looks/mat_004>
        double radius = 0.15
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.07, 0.05, 1.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Sphere "foliage_2" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_plant/Looks/mat_004>
        double radius = 0.14
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (-0.08, -0.06, 0.99)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Sphere "foliage_3" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_plant/Looks/mat_003>
        double radius = 0.12
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0.06, -0.1, 0.74)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Cube "collision_body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token purpose = "guide"
        double size = 1
        token visibility = "invisible"
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.45, 0.45, 1.18)
        double3 xformOp:translate = (0, 0, 0.59)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
