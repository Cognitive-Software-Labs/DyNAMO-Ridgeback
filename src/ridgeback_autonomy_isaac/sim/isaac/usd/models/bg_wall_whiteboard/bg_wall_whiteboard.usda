#usda 1.0
(
    defaultPrim = "bg_wall_whiteboard"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bg_wall_whiteboard"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Scope "Looks"
    {
        def Material "mat_000"
        {
            token outputs:surface.connect = </bg_wall_whiteboard/Looks/mat_000/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.71, 0.73)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }

        def Material "mat_001"
        {
            token outputs:surface.connect = </bg_wall_whiteboard/Looks/mat_001/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.94, 0.94, 0.94)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:roughness = 1
                token outputs:surface
            }
        }
    }

    def Cube "frame" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_wall_whiteboard/Looks/mat_000>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1.84, 0.03, 1.24)
        double3 xformOp:translate = (0, 0.005, 1.52)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "board" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </bg_wall_whiteboard/Looks/mat_001>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1.8, 0.01, 1.2)
        double3 xformOp:translate = (0, -0.015, 1.52)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "collision_body" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token purpose = "guide"
        double size = 1
        token visibility = "invisible"
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1.84, 0.04, 1.24)
        double3 xformOp:translate = (0, 0, 1.52)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
