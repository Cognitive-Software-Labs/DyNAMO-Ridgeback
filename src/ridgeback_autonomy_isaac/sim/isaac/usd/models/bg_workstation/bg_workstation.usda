#usda 1.0
(
    defaultPrim = "bg_workstation"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "bg_workstation"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Scope "Looks"
    {
        def Material "mat_000"
        {
            token outputs:surface.connect = </bg_workstation/Looks/mat_000/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </bg_workstation/Looks/mat_000/diffuse_texture.outputs:rgb>
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "st_reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "diffuse_texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/Desk_Diffuse.png@
                float4 inputs:scale = (0.8, 0.8, 0.8, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </bg_workstation/Looks/mat_000/st_reader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "mat_001"
        {
            token outputs:surface.connect = </bg_workstation/Looks/mat_001/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.164706, 0.207843, 0.207843)
                float inputs:roughness = 0.67
                token outputs:surface
            }
        }

        def Material "mat_002"
        {
            token outputs:surface.connect = </bg_workstation/Looks/mat_002/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.658823, 0.827451, 0.827451)
                float inputs:roughness = 0.67
                token outputs:surface
            }
        }

        def Material "mat_003"
        {
            token outputs:surface.connect = </bg_workstation/Looks/mat_003/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.368627, 0.466667, 0.466667)
                float inputs:roughness = 0.67
                token outputs:surface
            }
        }
    }

