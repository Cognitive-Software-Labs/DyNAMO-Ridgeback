#usda 1.0
(
    defaultPrim = "privacy_curtain"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "privacy_curtain"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

    def Scope "Looks"
    {
        def Material "mat_000"
        {
            token outputs:surface.connect = </privacy_curtain/Looks/mat_000/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.82, 0.88)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:opacity = 0.95
                float inputs:roughness = 1
                token outputs:surface
            }
        }
    }

    def Cube "visual" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </privacy_curtain/Looks/mat_000>
        double size = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.06, 1.7, 1.6)
        double3 xformOp:translate = (0, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Cube "collision" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token purpose = "guide"
        double size = 1
        token visibility = "invisible"
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (0.06, 1.7, 1.6)
        double3 xformOp:translate = (0, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
