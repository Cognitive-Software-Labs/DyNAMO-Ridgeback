#!/usr/bin/env python3

import math

import cv2
import numpy as np
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image


class CameraWindowsNode(Node):
    def __init__(self) -> None:
        super().__init__('camera_windows_node')

        self.declare_parameter('show_color', True)
        self.declare_parameter('show_depth', True)
        self.declare_parameter('color_topic', 'sensors/camera_0/color/image')
        self.declare_parameter('depth_topic', 'sensors/camera_0/depth/image')
        self.declare_parameter('color_window_name', 'Ridgeback Color Camera')
        self.declare_parameter('depth_window_name', 'Ridgeback Depth Camera')
        self.declare_parameter('depth_max_meters', 10.0)

        self.show_color = self.get_parameter('show_color').value
        self.show_depth = self.get_parameter('show_depth').value
        self.color_topic = self.get_parameter('color_topic').value
        self.depth_topic = self.get_parameter('depth_topic').value
        self.color_window_name = self.get_parameter('color_window_name').value
        self.depth_window_name = self.get_parameter('depth_window_name').value
        self.depth_max_meters = float(self.get_parameter('depth_max_meters').value)

        self.latest_color_frame = None
        self.latest_depth_frame = None
        self.color_subscription = None
        self.depth_subscription = None
        self.windows_initialized = False

        if self.show_color:
            self.color_subscription = self.create_subscription(
                Image,
                self.color_topic,
                self.color_callback,
                qos_profile_sensor_data,
            )
            self.get_logger().info(f'Subscribing to color stream: {self.color_topic}')

        if self.show_depth:
            self.depth_subscription = self.create_subscription(
                Image,
                self.depth_topic,
                self.depth_callback,
                qos_profile_sensor_data,
            )
            self.get_logger().info(f'Subscribing to depth stream: {self.depth_topic}')

        if not self.show_color and not self.show_depth:
            self.get_logger().warn('Both show_color and show_depth are false; nothing will be displayed.')

        self.create_timer(1.0 / 30.0, self.render_windows)

    def render_windows(self) -> None:
        self.initialize_windows()

        if self.latest_color_frame is not None:
            cv2.imshow(self.color_window_name, self.latest_color_frame)

        if self.latest_depth_frame is not None:
            cv2.imshow(self.depth_window_name, self.latest_depth_frame)

        cv2.waitKey(1)

    def initialize_windows(self) -> None:
        if self.windows_initialized:
            return

        if self.show_color:
            cv2.namedWindow(self.color_window_name, cv2.WINDOW_NORMAL)
            cv2.moveWindow(self.color_window_name, 60, 60)

        if self.show_depth:
            cv2.namedWindow(self.depth_window_name, cv2.WINDOW_NORMAL)
            cv2.moveWindow(self.depth_window_name, 760, 60)

        self.windows_initialized = True

    def color_callback(self, msg: Image) -> None:
        try:
            self.latest_color_frame = self.convert_color_image(msg)
        except ValueError as exc:
            self.get_logger().warn(f'Unable to display color image ({msg.encoding}): {exc}')

    def depth_callback(self, msg: Image) -> None:
        try:
            self.latest_depth_frame = self.convert_depth_image(msg)
        except ValueError as exc:
            self.get_logger().warn(f'Unable to display depth image ({msg.encoding}): {exc}')

    def convert_color_image(self, msg: Image) -> np.ndarray:
        image = self.decode_image(msg)

        if msg.encoding == 'rgb8':
            return cv2.cvtColor(image, cv2.COLOR_RGB2BGR)
        if msg.encoding == 'bgr8':
            return image
        if msg.encoding == 'rgba8':
            return cv2.cvtColor(image, cv2.COLOR_RGBA2BGR)
        if msg.encoding == 'bgra8':
            return cv2.cvtColor(image, cv2.COLOR_BGRA2BGR)
        if msg.encoding == 'mono8':
            return image
        if msg.encoding == 'mono16':
            return self.normalize_to_uint8(image)

        raise ValueError('unsupported color encoding')

    def convert_depth_image(self, msg: Image) -> np.ndarray:
        image = self.decode_image(msg)

        if msg.encoding == '16UC1':
            depth_meters = image.astype(np.float32) / 1000.0
            normalized = self.normalize_depth(depth_meters)
            return cv2.applyColorMap(normalized, cv2.COLORMAP_TURBO)

        if msg.encoding == '32FC1':
            normalized = self.normalize_depth(image.astype(np.float32))
            return cv2.applyColorMap(normalized, cv2.COLORMAP_TURBO)

        if msg.encoding == 'mono8':
            return cv2.applyColorMap(image, cv2.COLORMAP_TURBO)

        raise ValueError('unsupported depth encoding')

    def decode_image(self, msg: Image) -> np.ndarray:
        if msg.encoding in ('rgb8', 'bgr8'):
            return self.decode_buffer(msg, np.uint8, channels=3)
        if msg.encoding in ('rgba8', 'bgra8'):
            return self.decode_buffer(msg, np.uint8, channels=4)
        if msg.encoding == 'mono8':
            return self.decode_buffer(msg, np.uint8, channels=1)
        if msg.encoding in ('mono16', '16UC1'):
            return self.decode_buffer(msg, np.uint16, channels=1)
        if msg.encoding == '32FC1':
            return self.decode_buffer(msg, np.float32, channels=1)

        raise ValueError('unsupported encoding')

    def decode_buffer(self, msg: Image, dtype: np.dtype, channels: int) -> np.ndarray:
        dtype = np.dtype(dtype)
        row_elements = msg.step // dtype.itemsize
        expected_columns = msg.width * channels

        if row_elements < expected_columns:
            raise ValueError('message step is smaller than expected image width')

        buffer = np.frombuffer(msg.data, dtype=dtype).reshape(msg.height, row_elements)
        cropped = buffer[:, :expected_columns]

        if channels == 1:
            return cropped.reshape(msg.height, msg.width)

        return cropped.reshape(msg.height, msg.width, channels)

    def normalize_to_uint8(self, image: np.ndarray) -> np.ndarray:
        min_value = float(np.min(image))
        max_value = float(np.max(image))

        if math.isclose(min_value, max_value):
            return np.zeros(image.shape, dtype=np.uint8)

        scaled = (image.astype(np.float32) - min_value) / (max_value - min_value)
        return np.clip(scaled * 255.0, 0.0, 255.0).astype(np.uint8)

    def normalize_depth(self, image: np.ndarray) -> np.ndarray:
        valid = np.isfinite(image) & (image > 0.0)
        if self.depth_max_meters > 0.0:
            valid &= image <= self.depth_max_meters

        if not np.any(valid):
            return np.zeros(image.shape, dtype=np.uint8)

        clipped = image.copy()
        clipped[~valid] = 0.0
        max_value = self.depth_max_meters if self.depth_max_meters > 0.0 else float(np.max(clipped[valid]))

        if max_value <= 0.0:
            return np.zeros(image.shape, dtype=np.uint8)

        normalized = np.clip(clipped / max_value, 0.0, 1.0)
        return (normalized * 255.0).astype(np.uint8)

    def destroy_node(self) -> bool:
        cv2.destroyAllWindows()
        return super().destroy_node()


def main() -> None:
    rclpy.init()
    node = CameraWindowsNode()

    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
