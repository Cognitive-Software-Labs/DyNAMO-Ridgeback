#!/usr/bin/env python3

import math
import os

from ament_index_python.packages import get_package_share_directory
from message_filters import ApproximateTimeSynchronizer, Subscriber
import numpy as np
import rclpy
from rclpy.duration import Duration
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from rclpy.time import Time
from sensor_msgs.msg import Image, LaserScan
import torch
from tf2_ros import Buffer, TransformException, TransformListener
from transformers import pipeline as hf_pipeline

from g1_detection_common import (
    DETECTION_LABELS,
    DETECTION_MODEL_DEFAULT,
    DETECTION_THRESHOLD,
    SYNC_QUEUE_SIZE_DEFAULT,
    SYNC_SLOP_SEC_DEFAULT,
    bgr_frame_to_pil,
    convert_color_image_message,
    load_config,
    parse_owl_detections,
)
from g1_distance_common import apply_vehicle_front_offset
from ridgeback_slam_exploration.msg import G1Detection


LIDAR_MIN_RANGE_METERS = 0.05
LIDAR_MAX_METERS = 10.0
LIDAR_HALF_WINDOW_MARGIN_DEG = 0.75
LIDAR_HALF_WINDOW_SCALE = 0.25
LIDAR_HALF_WINDOW_FLOOR_DEG = 1.0
LIDAR_CLOSE_PERCENTILE = 30.0
LIDAR_INLIER_DISTANCE_MARGIN_M = 0.20
LIDAR_MIN_VALID_RAYS = 2
TF_LOOKUP_TIMEOUT_SEC = 0.5


class G1DetectionLidarNode(Node):
    def __init__(self) -> None:
        super().__init__('g1_detection_lidar_node')

        pkg_share = get_package_share_directory('ridgeback_slam_exploration')
        default_config = os.path.join(pkg_share, 'config', 'vlm_config.json')
        default_base_frame = self.default_base_frame()

        self.declare_parameter('detection_model', DETECTION_MODEL_DEFAULT)
        self.declare_parameter('detection_threshold', DETECTION_THRESHOLD)
        self.declare_parameter('vlm_config_path', default_config)
        self.declare_parameter('color_topic', 'sensors/camera_0/color/image')
        self.declare_parameter('scan_topic', 'sensors/lidar2d_0/scan')
        self.declare_parameter('base_frame', default_base_frame)
        self.declare_parameter('sync_queue_size', SYNC_QUEUE_SIZE_DEFAULT)
        self.declare_parameter('sync_slop_sec', SYNC_SLOP_SEC_DEFAULT)

        self.detection_model = self.get_parameter('detection_model').value
        self.detection_threshold = float(self.get_parameter('detection_threshold').value)
        self.vlm_config_path = self.get_parameter('vlm_config_path').value
        self.color_topic = self.get_parameter('color_topic').value
        self.scan_topic = self.get_parameter('scan_topic').value
        self.base_frame = self.get_parameter('base_frame').value or default_base_frame
        self.sync_queue_size = int(self.get_parameter('sync_queue_size').value)
        self.sync_slop_sec = float(self.get_parameter('sync_slop_sec').value)

        self.config = load_config(self.vlm_config_path)
        self.camera_hfov_rad = math.radians(self.config['camera']['depth_hfov_deg'])
        self.latest_synced_messages = None
        self.last_lidar_warning = None
        self.last_base_frame_fallback = None

        self.get_logger().info(f'Loading detection model: {self.detection_model}')
        detector_device = 'cuda' if torch.cuda.is_available() else 'cpu'
        self.get_logger().info(f'Using detection device: {detector_device}')
        self.detector = hf_pipeline(
            task='zero-shot-object-detection',
            model=self.detection_model,
            device=detector_device,
        )
        self.get_logger().info('Detection model loaded.')

        self.tf_buffer = Buffer(node=self)
        self.tf_listener = TransformListener(self.tf_buffer, self, spin_thread=False)

        self.color_subscriber = Subscriber(
            self,
            Image,
            self.color_topic,
            qos_profile=qos_profile_sensor_data,
        )
        self.scan_subscriber = Subscriber(
            self,
            LaserScan,
            self.scan_topic,
            qos_profile=qos_profile_sensor_data,
        )
        self.sync = ApproximateTimeSynchronizer(
            [self.color_subscriber, self.scan_subscriber],
            queue_size=self.sync_queue_size,
            slop=self.sync_slop_sec,
        )
        self.sync.registerCallback(self.synced_callback)
        self.get_logger().info(f'Subscribed to color stream: {self.color_topic}')
        self.get_logger().info(f'Subscribed to LiDAR stream: {self.scan_topic}')
        self.get_logger().info(f'Using base frame: {self.base_frame}')

        self.detection_pub = self.create_publisher(G1Detection, 'vlm/g1_detection_lidar', 10)

    def default_base_frame(self) -> str:
        namespace_name = self.get_namespace().strip('/')
        if namespace_name:
            return f'{namespace_name}/robot/base_link'
        return 'robot/base_link'

    def synced_callback(self, color_msg: Image, scan_msg: LaserScan) -> None:
        self.latest_synced_messages = (color_msg, scan_msg)

    def run_detection_loop(self) -> None:
        while rclpy.ok():
            rclpy.spin_once(self, timeout_sec=0.1)
            if self.latest_synced_messages is None:
                continue

            color_msg, scan_msg = self.latest_synced_messages
            self.latest_synced_messages = None

            try:
                frame = convert_color_image_message(color_msg)
            except ValueError as exc:
                self.get_logger().warn(
                    f'Cannot decode color image ({color_msg.encoding}): {exc}'
                )
                continue

            scan_points = None
            lidar_warning = None
            try:
                scan_points = self.extract_scan_points_base(scan_msg)
            except (TransformException, ValueError) as exc:
                lidar_warning = str(exc)
                self.log_lidar_warning(lidar_warning)

            pil_image = bgr_frame_to_pil(frame)
            self.get_logger().info('Running LiDAR-backed detection...')
            outputs = self.detector(
                pil_image,
                candidate_labels=DETECTION_LABELS,
            )

            detection = parse_owl_detections(
                outputs,
                frame.shape[1],
                frame.shape[0],
                self.detection_threshold,
            )
            detection = self.add_lidar_distances(detection, scan_points)

            for robot in detection['robots']:
                lidar_distance = robot.get('lidar_distance_m')
                lidar_text = f'{lidar_distance:.2f}m' if lidar_distance is not None else 'N/A'
                self.get_logger().info(
                    f'Detected: {robot["label"]} (score={robot["score"]:.2f}) '
                    f'bbox={robot["bbox_pixel"]} LiDARD={lidar_text}'
                )

            if not detection['detected']:
                self.get_logger().info('No detections above threshold.')
            elif lidar_warning is not None:
                self.get_logger().warn(
                    f'Detections were published without LiDAR distance: {lidar_warning}'
                )

            self.publish_detection(detection, color_msg.header)

    def extract_scan_points_base(self, scan_msg: LaserScan) -> dict[str, np.ndarray]:
        ranges = np.asarray(scan_msg.ranges, dtype=np.float32)
        if ranges.size == 0:
            raise ValueError('LaserScan contains no ranges.')

        rotation, translation = self.lookup_transform_components(scan_msg)

        valid = np.isfinite(ranges)
        safe_ranges = ranges.copy()
        safe_ranges[~valid] = 0.0

        range_min = max(float(scan_msg.range_min), LIDAR_MIN_RANGE_METERS)
        if range_min > 0.0:
            valid &= safe_ranges >= range_min

        range_max = float(scan_msg.range_max)
        if math.isfinite(range_max) and range_max > 0.0:
            valid &= safe_ranges <= min(range_max, LIDAR_MAX_METERS)
        else:
            valid &= safe_ranges <= LIDAR_MAX_METERS

        if not np.any(valid):
            raise ValueError('LaserScan contains no valid ranges.')

        angles = scan_msg.angle_min + (
            np.arange(ranges.size, dtype=np.float32) * np.float32(scan_msg.angle_increment)
        )
        points_scan = np.stack((
            safe_ranges * np.cos(angles),
            safe_ranges * np.sin(angles),
            np.zeros_like(safe_ranges),
        ), axis=1)
        points_base = points_scan @ rotation.T + translation

        forward_m = points_base[:, 0]
        lateral_m = points_base[:, 1]
        planar_distance_m = np.hypot(forward_m, lateral_m)
        bearing_rad = np.arctan2(lateral_m, forward_m)

        valid &= np.isfinite(forward_m) & np.isfinite(lateral_m) & np.isfinite(planar_distance_m)
        valid &= forward_m > 0.0
        valid &= planar_distance_m <= LIDAR_MAX_METERS
        if not np.any(valid):
            raise ValueError('LaserScan points do not contain valid forward returns.')

        return {
            'forward_m': forward_m,
            'lateral_m': lateral_m,
            'planar_distance_m': planar_distance_m,
            'bearing_rad': bearing_rad,
            'valid': valid,
        }

    def add_lidar_distances(
        self,
        detection: dict,
        scan_points: dict[str, np.ndarray] | None,
    ) -> dict:
        for robot in detection['robots']:
            robot['lidar_x_m'] = None
            robot['lidar_z_m'] = None
            robot['lidar_distance_m'] = None

        if not detection['detected'] or scan_points is None:
            return detection

        for robot in detection['robots']:
            measurement = self.compute_lidar_measurement(
                scan_points,
                robot['bbox_pixel'],
                detection['img_width'],
            )
            if measurement is None:
                continue

            lateral_m, forward_m, distance_m = measurement
            robot['lidar_x_m'] = lateral_m
            robot['lidar_z_m'] = forward_m
            robot['lidar_distance_m'] = distance_m

        return detection

    def compute_lidar_measurement(
        self,
        scan_points: dict[str, np.ndarray],
        bbox_pixel,
        image_width: int,
    ) -> tuple[float, float, float] | None:
        center_bearing_rad, half_window_rad = self.compute_camera_bearing_window(
            bbox_pixel,
            image_width,
        )

        bearing_delta = self.wrap_angle(scan_points['bearing_rad'] - center_bearing_rad)
        gate = scan_points['valid'] & (np.abs(bearing_delta) <= half_window_rad)
        if int(np.count_nonzero(gate)) < LIDAR_MIN_VALID_RAYS:
            return None

        gated_lateral = scan_points['lateral_m'][gate]
        gated_forward = scan_points['forward_m'][gate]
        gated_planar = scan_points['planar_distance_m'][gate]

        anchor_distance_m = float(np.percentile(gated_planar, LIDAR_CLOSE_PERCENTILE))
        inliers = gated_planar <= anchor_distance_m + LIDAR_INLIER_DISTANCE_MARGIN_M
        if not np.any(inliers):
            return None

        lateral_m = float(np.median(gated_lateral[inliers]))
        forward_m = float(np.median(gated_forward[inliers]))
        lateral_m, forward_m = apply_vehicle_front_offset(lateral_m, forward_m)

        distance_m = float(math.hypot(lateral_m, forward_m))
        if forward_m <= 0.0 or distance_m > LIDAR_MAX_METERS:
            return None
        return lateral_m, forward_m, distance_m

    def compute_camera_bearing_window(
        self,
        bbox_pixel,
        image_width: int,
    ) -> tuple[float, float]:
        x1, _, x2, _ = bbox_pixel
        fx = image_width / (2.0 * math.tan(self.camera_hfov_rad / 2.0))
        cx0 = image_width / 2.0

        left_bearing_rad = math.atan2(x1 - cx0, fx)
        right_bearing_rad = math.atan2((x2 - 1) - cx0, fx)
        center_bearing_rad = 0.5 * (left_bearing_rad + right_bearing_rad)
        half_window_rad = 0.5 * abs(right_bearing_rad - left_bearing_rad)

        margin_rad = max(
            math.radians(LIDAR_HALF_WINDOW_MARGIN_DEG),
            half_window_rad * LIDAR_HALF_WINDOW_SCALE,
        )
        half_window_rad = max(
            half_window_rad + margin_rad,
            math.radians(LIDAR_HALF_WINDOW_FLOOR_DEG),
        )
        return center_bearing_rad, half_window_rad

    def lookup_transform_components(self, scan_msg: LaserScan):
        timestamp = Time.from_msg(scan_msg.header.stamp)
        last_error = None

        for target_frame in self.candidate_base_frames():
            try:
                transform = self.tf_buffer.lookup_transform(
                    target_frame,
                    scan_msg.header.frame_id,
                    timestamp,
                    timeout=Duration(seconds=TF_LOOKUP_TIMEOUT_SEC),
                )
            except TransformException as exc:
                last_error = exc
                continue

            if target_frame != self.base_frame and target_frame != self.last_base_frame_fallback:
                self.last_base_frame_fallback = target_frame
                self.get_logger().warn(
                    f'Configured base frame "{self.base_frame}" is unavailable; '
                    f'using "{target_frame}" for LiDAR transforms.'
                )

            translation = np.array([
                transform.transform.translation.x,
                transform.transform.translation.y,
                transform.transform.translation.z,
            ], dtype=np.float32)
            rotation = self.rotation_matrix_from_quaternion(transform.transform.rotation)
            return rotation, translation

        if last_error is None:
            raise TransformException('No candidate base frames were available.')
        raise last_error

    def candidate_base_frames(self) -> list[str]:
        candidates = []
        for candidate in (self.base_frame, self.base_frame.split('/')[-1]):
            if candidate and candidate not in candidates:
                candidates.append(candidate)
        return candidates

    def rotation_matrix_from_quaternion(self, quaternion) -> np.ndarray:
        x = quaternion.x
        y = quaternion.y
        z = quaternion.z
        w = quaternion.w
        return np.array([
            [1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - z * w), 2.0 * (x * z + y * w)],
            [2.0 * (x * y + z * w), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z - x * w)],
            [2.0 * (x * z - y * w), 2.0 * (y * z + x * w), 1.0 - 2.0 * (x * x + y * y)],
        ], dtype=np.float32)

    def wrap_angle(self, angle_rad):
        return np.arctan2(np.sin(angle_rad), np.cos(angle_rad))

    def log_lidar_warning(self, warning: str) -> None:
        if warning == self.last_lidar_warning:
            return
        self.last_lidar_warning = warning
        self.get_logger().warn(warning)

    def publish_detection(self, detection: dict, header) -> None:
        msg = G1Detection()
        msg.header = header
        msg.detected = detection['detected']
        msg.count = detection['count']
        msg.img_width = detection['img_width']
        msg.img_height = detection['img_height']

        for robot in detection['robots']:
            x1, y1, x2, y2 = [float(value) for value in robot['bbox_pixel']]
            msg.bbox.extend([x1, y1, x2, y2])
            msg.position_x.append(0.0)
            msg.position_z.append(0.0)
            msg.distance.append(0.0)
            msg.depth_distance.append(0.0)
            msg.depth_anything_distance.append(0.0)
            msg.pointcloud_position_x.append(0.0)
            msg.pointcloud_position_z.append(0.0)
            msg.pointcloud_distance.append(0.0)
            msg.lidar_position_x.append(robot.get('lidar_x_m') or 0.0)
            msg.lidar_position_z.append(robot.get('lidar_z_m') or 0.0)
            msg.lidar_distance.append(robot.get('lidar_distance_m') or 0.0)

        self.detection_pub.publish(msg)


def main() -> None:
    rclpy.init()
    node = G1DetectionLidarNode()

    try:
        node.run_detection_loop()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
