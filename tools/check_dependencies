#!/bin/bash
# Verify pinned dependency revisions and optionally apply the recorded patches.
# Usage: tools/check_dependencies [--apply] [--profile core|gz|viz|all]

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECKOUT_ROOT="${DYNAMO_DEPENDENCY_ROOT:-$REPO_ROOT}"
APPLY_PATCHES=false
PROFILE=all

while [ "$#" -gt 0 ]; do
    case "$1" in
        --apply)
            APPLY_PATCHES=true
            ;;
        --profile)
            shift
            PROFILE="${1:-}"
            ;;
        *)
            echo "Usage: tools/check_dependencies [--apply] [--profile core|gz|viz|all]" >&2
            exit 2
            ;;
    esac
    shift
done

case "$PROFILE" in
    core) MANIFESTS=("$REPO_ROOT/dependencies/core.repos") ;;
    gz) MANIFESTS=("$REPO_ROOT/dependencies/gz.repos") ;;
    viz) MANIFESTS=("$REPO_ROOT/dependencies/viz.repos") ;;
    all) MANIFESTS=("$REPO_ROOT/dependencies/core.repos"
                    "$REPO_ROOT/dependencies/gz.repos"
                    "$REPO_ROOT/dependencies/viz.repos") ;;
    *)
        echo "Unknown dependency profile: $PROFILE" >&2
        exit 2
        ;;
esac

declare -A PATCHES=(
    [src/clearpath_simulator]="patches/clearpath_gz_customizations.patch"
    [src/clearpath_common]="patches/clearpath_realsense_sim_frames.patch"
    [src/slam_toolbox]="patches/slam_toolbox_tf_namespace.patch"
    [src/gz-sim]="patches/gz_sim_sensors_shutdown.patch"
    [src/ros_gz]="patches/ros_gz_bridge_shutdown.patch"
    [src/rviz]="patches/rviz_shutdown.patch"
)

# Partial overlays: checkouts of which only the listed top-level packages are
# built. Every other package directory carries an untracked, empty
# COLCON_IGNORE, so the overlay replaces exactly the patched packages and the
# rest keep resolving to the installed binaries.
declare -A BUILD_ONLY=(
    [src/ros_gz]="ros_gz_bridge ros_gz_image"
    # rviz_default_plugins requires the testing framework when BUILD_TESTING is on.
    [src/rviz]="rviz_common rviz_default_plugins rviz_visual_testing_framework"
)

if ! dependency_text="$(python3 - "${MANIFESTS[@]}" <<'PY'
import sys

import yaml

seen = set()
for manifest in sys.argv[1:]:
    with open(manifest, encoding='utf-8') as stream:
        repositories = yaml.safe_load(stream)['repositories']
    for path, specification in repositories.items():
        if path in seen:
            raise ValueError(f'duplicate dependency {path} in {manifest}')
        seen.add(path)
        print(f"{path}\t{specification['version']}")
PY
)"; then
    echo "ERROR: could not parse dependency profile $PROFILE" >&2
    exit 1
fi

if [ -z "$dependency_text" ]; then
    echo "ERROR: dependency profile $PROFILE contains no dependencies" >&2
    exit 1
fi
mapfile -t DEPENDENCIES <<< "$dependency_text"

failures=0

fail() {
    echo "ERROR: $*" >&2
    failures=$((failures + 1))
}

# The COLCON_IGNORE markers a partial overlay needs: one for every top-level
# package directory that is not kept, unless upstream already ignores it.
expected_build_markers() {
    local checkout="$1"
    shift
    local -A kept=()
    local package manifest directory
    for package in "$@"; do
        kept["$package"]=1
    done
    for manifest in "$checkout"/*/package.xml; do
        [ -e "$manifest" ] || continue
        directory="$(basename "$(dirname "$manifest")")"
        [ -n "${kept[$directory]:-}" ] && continue
        if [ -n "$(git -C "$checkout" ls-files -- "$directory/COLCON_IGNORE" \
                "$directory/AMENT_IGNORE" "$directory/CATKIN_IGNORE")" ]; then
            continue
        fi
        echo "$directory/COLCON_IGNORE"
    done
}

# Check, and with --apply complete, a partial overlay's build markers. Prints
# nothing and returns 0 when the checkout builds exactly its kept packages.
check_build_markers() {
    local relative_path="$1"
    local checkout="$2"
    local -a kept
    read -r -a kept <<< "${BUILD_ONLY[$relative_path]}"
    local package marker problems=0
    for package in "${kept[@]}"; do
        if [ ! -f "$checkout/$package/package.xml" ]; then
            fail "$relative_path has no package $package to build"
            problems=1
        fi
        for marker in COLCON_IGNORE AMENT_IGNORE CATKIN_IGNORE; do
            if [ -e "$checkout/$package/$marker" ]; then
                fail "$relative_path/$package must be built but contains $marker"
                problems=1
            fi
        done
    done
    [ "$problems" -eq 0 ] || return 1

    local -A expected=()
    local -a missing=()
    while IFS= read -r marker; do
        [ -n "$marker" ] || continue
        expected["$marker"]=1
        [ -e "$checkout/$marker" ] || missing+=("$marker")
    done < <(expected_build_markers "$checkout" "${kept[@]}")

    local untracked unexpected=()
    while IFS= read -r untracked; do
        [ -n "$untracked" ] || continue
        [ -n "${expected[$untracked]:-}" ] || unexpected+=("$untracked")
    done < <(git -C "$checkout" ls-files --others --exclude-standard)
    if [ "${#unexpected[@]}" -ne 0 ]; then
        local joined
        joined="$(printf '%s, ' "${unexpected[@]}")"
        fail "$relative_path has untracked files: ${joined%, }"
        return 1
    fi

    if [ "${#missing[@]}" -ne 0 ]; then
        if [ "$APPLY_PATCHES" = false ]; then
            fail "$relative_path is missing ${#missing[@]} COLCON_IGNORE marker(s); rerun with --apply"
            return 1
        fi
        for marker in "${missing[@]}"; do
            : > "$checkout/$marker"
        done
        echo "MARKED: ${#missing[@]} package(s) of $relative_path skipped by colcon"
    fi
    return 0
}

# Record the files a patch creates as intent-to-add, so they are part of
# `git diff HEAD` instead of untracked files. (`git apply --intent-to-add`
# itself empties the index in Git before 2.44.)
mark_created_files() {
    local patch="$1"
    local checkout="$2"
    local -a created=()
    local line
    while IFS= read -r line; do
        created+=("${line##* create mode * }")
    done < <(git -C "$checkout" apply --summary "$patch" | grep '^ create mode ')
    [ "${#created[@]}" -eq 0 ] || git -C "$checkout" add --intent-to-add -- "${created[@]}"
}

patch_matches_checkout() {
    local patch="$1"
    local checkout="$2"
    # Git-generated diffs prefix a blank context line with one space. Recorded
    # patch files omit that otherwise-trailing byte so the root repository's
    # own `git diff --check` stays clean. Normalize only this no-content case;
    # every behavior-bearing byte must still match exactly.
    diff -q \
        <(sed 's/^ $//' "$patch") \
        <(git -C "$checkout" diff --no-ext-diff HEAD -- | sed 's/^ $//') \
        >/dev/null
}

for dependency in "${DEPENDENCIES[@]}"; do
    IFS=$'\t' read -r relative_path expected_revision <<< "$dependency"
    checkout="$CHECKOUT_ROOT/$relative_path"
    patch_relative="${PATCHES[$relative_path]:-}"

    if [ ! -e "$checkout/.git" ]; then
        fail "$relative_path is missing; import the $PROFILE dependency profile"
        continue
    fi

    actual_revision="$(git -C "$checkout" rev-parse HEAD)"
    if [ "$actual_revision" != "$expected_revision" ]; then
        fail "$relative_path is at $actual_revision, expected $expected_revision"
        continue
    fi

    if [ -n "${BUILD_ONLY[$relative_path]:-}" ]; then
        check_build_markers "$relative_path" "$checkout" || continue
    else
        untracked="$(git -C "$checkout" ls-files --others --exclude-standard)"
        if [ -n "$untracked" ]; then
            fail "$relative_path has untracked files: ${untracked//$'\n'/, }"
            continue
        fi
    fi

    if [ -z "$patch_relative" ]; then
        if git -C "$checkout" diff --quiet HEAD --; then
            echo "OK: $relative_path @ ${expected_revision:0:8} (clean)"
        else
            fail "$relative_path has unexpected tracked modifications"
        fi
        continue
    fi

    patch="$REPO_ROOT/$patch_relative"
    if git -C "$checkout" apply --reverse --check "$patch" >/dev/null 2>&1; then
        if patch_matches_checkout "$patch" "$checkout"; then
            echo "OK: $relative_path @ ${expected_revision:0:8} ($patch_relative applied)"
        else
            fail "$relative_path contains changes beyond $patch_relative"
        fi
        continue
    fi

    if ! git -C "$checkout" apply --check "$patch" >/dev/null 2>&1; then
        fail "$patch_relative is neither cleanly applied nor cleanly applicable"
        continue
    fi

    if [ "$APPLY_PATCHES" = false ]; then
        fail "$patch_relative is not applied; rerun with --apply"
        continue
    fi

    if git -C "$checkout" apply "$patch" &&
       mark_created_files "$patch" "$checkout" &&
       patch_matches_checkout "$patch" "$checkout"; then
        echo "APPLIED: $patch_relative to $relative_path @ ${expected_revision:0:8}"
    else
        fail "$patch_relative did not produce the recorded dependency diff"
    fi
done

if [ "$failures" -ne 0 ]; then
    echo "$failures dependency check(s) failed." >&2
    exit 1
fi

echo "All $PROFILE dependencies match their manifests and contain only recorded patches."
