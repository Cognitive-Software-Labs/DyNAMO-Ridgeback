#!/bin/bash
# graphify-hook-start
# Rebuild and stage the knowledge graph before committing code changes.
# Uses tools/rebuild_graphify — the canonical rebuild path for this repo.
# Installed by: tools/install_hooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

CHANGED=$(git diff --cached --name-only --diff-filter=ACMRD)
if [ -z "$CHANGED" ]; then
    exit 0
fi

CODE_EXTS="\.py$|\.ts$|\.js$|\.go$|\.rs$|\.java$|\.cpp$|\.c$|\.rb$|\.swift$|\.kt$|\.cs$|\.scala$|\.php$|\.cc$|\.cxx$|\.hpp$|\.h$|\.kts$"
CODE_CHANGED=$(echo "$CHANGED" | grep -E "$CODE_EXTS" || true)

if [ -z "$CODE_CHANGED" ]; then
    exit 0
fi

CODE_COUNT=$(echo "$CODE_CHANGED" | wc -l | tr -d ' ')
echo "[graphify hook] ${CODE_COUNT} staged code file(s) changed - rebuilding graph..."

if [ ! -x "$REPO_ROOT/tools/rebuild_graphify" ]; then
    echo "[graphify hook] tools/rebuild_graphify not found" >&2
    exit 1
fi

"$REPO_ROOT/tools/rebuild_graphify"
git add -- \
    graphify-out/GRAPH_REPORT.md \
    graphify-out/graph.html \
    graphify-out/graph.json
# graphify-hook-end
