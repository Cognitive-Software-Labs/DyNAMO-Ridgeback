#!/usr/bin/env python3
"""GPU gate for a perception venv: fails instead of letting inference fall back to CPU.

Usage, with ROS sourced, from the venv being checked:
  source /opt/ros/jazzy/setup.bash
  ~/venvs/dynamo-perception/bin/python3 tools/intel_thor/check_perception_env [--output FILE]

Checks that PyTorch sees a CUDA device, that the installed build carries kernels
for that device's architecture (sm_110 on Thor, sm_120 on the workstation), and
that real work runs there: a 4096x4096 matrix product, a convolution and
torchvision's NMS. Also checks that the venv imports ROS (rclpy, cv_bridge) and
the model stack. Prints a JSON report; exits nonzero if any check fails.
"""
import argparse
import importlib
import json
import platform
import sys
import time


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--output', help='also write the JSON report here')
    args = parser.parse_args(argv)
    checks, report = [], {'python': sys.version.split()[0], 'prefix': sys.prefix,
                          'machine': platform.machine()}

    def check(name, passed, detail=''):
        checks.append({'check': name, 'passed': bool(passed), 'detail': str(detail)})

    for module in ('rclpy', 'cv_bridge', 'numpy', 'transformers', 'accelerate', 'PIL'):
        try:
            imported = importlib.import_module(module)
            check(f'import {module}', True, getattr(imported, '__version__', ''))
        except Exception as error:  # report every missing piece, not only the first
            check(f'import {module}', False, f'{type(error).__name__}: {error}')
    try:
        import torch
        import torchvision
        report.update(torch=torch.__version__, torchvision=torchvision.__version__,
                      torch_cuda=torch.version.cuda, cudnn=torch.backends.cudnn.version())
        check('CUDA available', torch.cuda.is_available())
        if torch.cuda.is_available():
            major, minor = torch.cuda.get_device_capability(0)
            arch, arch_list = f'sm_{major}{minor}', torch.cuda.get_arch_list()
            report.update(device=torch.cuda.get_device_name(0), capability=[major, minor], arch_list=arch_list)
            check('build has kernels for this GPU', arch in arch_list, f'{arch} in {arch_list}')
            device = torch.device('cuda')
            a = torch.randn(4096, 4096, device=device)
            torch.cuda.synchronize()
            start = time.perf_counter()
            product = a @ a
            torch.cuda.synchronize()
            check('matrix product on cuda', product.is_cuda and torch.isfinite(product).all().item(),
                  f'{(time.perf_counter() - start) * 1e3:.1f} ms')
            conv = torch.nn.Conv2d(3, 16, 3).to(device)
            out = conv(torch.randn(1, 3, 480, 640, device=device))
            check('convolution on cuda', out.is_cuda, tuple(out.shape))
            boxes = torch.tensor([[0., 0., 10., 10.], [1., 1., 11., 11.], [50., 50., 60., 60.]], device=device)
            kept = torchvision.ops.nms(boxes, torch.tensor([.9, .8, .7], device=device), .5)
            check('torchvision NMS on cuda', kept.is_cuda and kept.tolist() == [0, 2], kept.tolist())
            report['peak_memory_mb'] = round(torch.cuda.max_memory_allocated() / 2**20, 1)
    except Exception as error:
        check('torch', False, f'{type(error).__name__}: {error}')
    report['checks'] = checks
    report['passed'] = all(item['passed'] for item in checks)
    text = json.dumps(report, indent=2)
    print(text)
    if args.output:
        with open(args.output, 'w') as handle:
            handle.write(text + '\n')
    return 0 if report['passed'] else 1


if __name__ == '__main__':
    sys.exit(main())
